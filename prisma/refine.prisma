generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres", "multiSchema"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ===== CORE IDENTITY & AUTHENTICATION SYSTEM =====

model User {    
    id        String   @id @default(uuid())
    email     String?  @unique // Nullable for social-only accounts
    phone     String?  @unique
    status    UserStatus @default(PENDING_VERIFICATION)

    // Email/phone verification
    emailVerifiedAt DateTime? @map("email_verified_at")
    phoneVerifiedAt DateTime? @map("phone_verified_at")

    // Security & tracking
    lastLoginAt     DateTime? @map("last_login_at")
    loginAttempts   Int       @default(0) @map("login_attempts")
    lockedUntil     DateTime? @map("locked_until")

    // Multi-tenancy support
    tenantId        String?   @map("tenant_id")

    // Audit fields
    isActive        Boolean   @default(true) @map("is_active")
    createdAt       DateTime  @default(now()) @map("created_at")
    updatedAt       DateTime  @updatedAt @map("updated_at")
    createdBy       String?   @map("created_by") // For admin-created accounts

    // Relations
    auth              UserAuth?
    profiles        UserProfile[] @relation("UserProfileUser")
    managedProfiles UserProfile[] @relation("UserProfileManager")
    socialAccounts    UserSocial[]
    roles             UserRole[]
    permissions       UserPermission[]
    keyTokens         UserKeyToken[]
    passwordResets    PasswordReset[]
    loginAttemptLogs  LoginAttempt[]
    cart              Cart?
    orders            Order[]
    comments          Comment[]
    addresses         UserAddress[]
    paymentMethods    PaymentMethod[]
    wallets           UserWallet[]
    loyaltyPrograms   UserLoyaltyProgram[]
    messages          Message[] @relation("UserMessages")
    notificationThread NotificationThread?
    auditLogs         AuditLog[] @relation("UserAuditLogs")
    createdAuditLogs  AuditLog[] @relation("CreatedByUser")
    productSnapshots        ProductSnapshot[]
    userSnapshots          UserSnapshot[]
    userSnapshotChanges    UserSnapshot[] @relation("UserSnapshotChanger")
    detailedAuditsUser     DetailedAuditLog[] @relation("DetailedAuditUser")
    detailedAuditsApprover DetailedAuditLog[] @relation("DetailedAuditApprover")
    notificationQueue      NotificationQueue[]
    savedSearches          SavedSearch[]
    queryPerformance       QueryPerformance[]
    flagEvaluations        FlagEvaluation[]
    supportTickets     SupportTicket[]
    assignedTickets    SupportTicket[] @relation("AssignedTickets")
    ticketResponses    TicketResponse[]
    ticketAttachments  TicketAttachment[]
    authoredPages      Page[] @relation("AuthoredPages")
    editedPages        Page[] @relation("EditedPages")
    blogPosts          BlogPost[]
    following          UserFollow[] @relation("UserFollowing")
    followers          UserFollow[] @relation("UserFollowers")
    socialShares       SocialShare[]
    activities         UserActivity[]
    mediaFiles         MediaFile[]
    systemConfigs      SystemConfig[]
    searchQueries      SearchQuery[]
    commentLikes       CommentLike[]
    reviewVotes        ReviewHelpfulVote[]
    discountUsages     DiscountUsage[]
    wishlists          Wishlist[]
    productReviews     ProductReview[]
    recommendations     ProductRecommendation[]
    abTestAssignments   ABTestAssignment[]
    fraudAlerts         FraudAlert[]
    fraudInvestigations FraudAlert[] @relation("FraudInvestigator")
    dashboards          Dashboard[]
    translations        Translation[]


    // Customer specific
    customerPreferences Json? @map("customer_preferences")
    marketingConsent   Boolean @default(false) @map("marketing_consent")

    @@index([email])
    @@index([phone])
    @@index([status])
    @@index([tenantId])
    @@map("users")
}

model UserAuth {
  userId        String    @id @map("user_id")
  username      String?   @unique
  passwordHash  String?   @map("password_hash")
  salt          String?
  
  // Security settings
  twoFactorEnabled    Boolean @default(false) @map("two_factor_enabled")
  twoFactorSecret     String? @map("two_factor_secret")
  backupCodes         String[] @default([]) @map("backup_codes")
  
  // Password policies
  passwordExpiresAt   DateTime? @map("password_expires_at")
  mustChangePassword  Boolean @default(false) @map("must_change_password")
  
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("user_auth")
}

model UserProfile {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  profileType   ProfileType @map("profile_type") // CUSTOMER, ADMIN, VENDOR_MANAGER
  
  // Personal info
  firstName     String?   @map("first_name")
  lastName      String?   @map("last_name")
  displayName   String?   @map("display_name")
  avatar        String?
  dateOfBirth   DateTime? @map("date_of_birth")
  gender        Gender?
  
  // Contact info
  alternativeEmail String? @map("alternative_email")
  alternativePhone String? @map("alternative_phone")
  
  // Localization
  locale        String    @default("en")
  timezone      String    @default("UTC")
  currency      String    @default("USD")
  
  // Admin specific fields
  employeeId    String?   @unique @map("employee_id")
  department    String?
  position      String?
  hireDate      DateTime? @map("hire_date")
  managerId     String?   @map("manager_id")
  
  // Customer specific fields
  customerTier  CustomerTier? @map("customer_tier")
  loyaltyPoints Int       @default(0) @map("loyalty_points")
  
  isPrimary     Boolean   @default(false) @map("is_primary") // One primary profile per user
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  manager       User?     @relation(fields: [managerId], references: [id])
  
  @@unique([userId, profileType])
  @@index([profileType])
  @@map("user_profiles")
}

model UserSocial {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  provider      SocialProvider
  providerId    String    @map("provider_id")
  email         String?
  username      String?
  displayName   String?   @map("display_name")
  avatar        String?
  
  // OAuth tokens (encrypted)
  accessToken   String?   @map("access_token")
  refreshToken  String?   @map("refresh_token")
  tokenExpiresAt DateTime? @map("token_expires_at")
  
  // Additional provider data
  providerData  Json?     @map("provider_data")
  
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@unique([provider, providerId])
  @@unique([userId, provider])
  @@map("user_social_accounts")
}

model UserAddress {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  label         String    // "Home", "Work", "Billing", etc.
  recipientName String    @map("recipient_name")
  phone         String?
  
  // Address components
  addressLine1  String    @map("address_line_1")
  addressLine2  String?   @map("address_line_2")
  city          String
  state         String?
  postalCode    String    @map("postal_code")
  countryCode   String    @map("country_code")
  
  // Geographic coordinates for delivery optimization
  latitude      Float?
  longitude     Float?
  
  // Address metadata
  addressType   AddressType @default(SHIPPING) @map("address_type")
  isDefault     Boolean   @default(false) @map("is_default")
  isVerified    Boolean   @default(false) @map("is_verified")
  
  // Delivery instructions
  instructions  String?
  accessCode    String?   @map("access_code")
  
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders        Order[]
  
  @@index([userId, isDefault])
  @@index([countryCode])
  @@map("user_addresses")
}

// ===== ADVANCED RBAC SYSTEM =====

model Role {
  id            String    @id @default(uuid())
  name          String    @unique // admin, super_admin, shop_owner, shop_staff, customer, etc.
  displayName   String    @map("display_name")
  description   String?
  level         Int       @default(0) // Role hierarchy level
  isSystemRole  Boolean   @default(false) @map("is_system_role")
  
  // Role constraints
  maxUsers      Int?      @map("max_users") // Limit number of users with this role
  requiresApproval Boolean @default(false) @map("requires_approval")
  
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  permissions   RolePermission[]
  users         UserRole[]
  
  @@map("roles")
}

model Permission {
  id            String    @id @default(uuid())
  name          String    @unique // users.create, products.manage, orders.view, etc.
  resource      String    // users, products, orders, reports, etc.
  action        String    // create, read, update, delete, manage, etc.
  description   String?
  category      String?   // Group related permissions
  
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  roles         RolePermission[]
  users         UserPermission[]
  
  @@unique([resource, action])
  @@index([resource])
  @@index([category])
  @@map("permissions")
}

model RolePermission {
  id            String    @id @default(uuid())
  roleId        String    @map("role_id")
  permissionId  String    @map("permission_id")
  
  createdAt     DateTime  @default(now()) @map("created_at")

  role          Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  
  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  roleId        String    @map("role_id")
  
  // Context support (shop-specific, region-specific, etc.)
  contextType   String?   @map("context_type") // shop, region, category
  contextId     String?   @map("context_id")
  
  // Role assignment metadata
  assignedBy    String    @map("assigned_by")
  assignedAt    DateTime  @default(now()) @map("assigned_at")
  expiresAt     DateTime? @map("expires_at")
  
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role          Role      @relation(fields: [roleId], references: [id], onDelete: Cascade)
  assignedByUser User     @relation(fields: [assignedBy], references: [id])
  
  @@unique([userId, roleId, contextType, contextId])
  @@index([userId])
  @@index([roleId])
  @@index([contextType, contextId])
  @@map("user_roles")
}

model UserPermission {
  id            String    @id @default(uuid())
  userId        String    @map("user_id")
  permissionId  String    @map("permission_id")
  
  granted       Boolean   @default(true) // true = grant, false = deny
  
  // Context support
  contextType   String?   @map("context_type")
  contextId     String?   @map("context_id")
  
  assignedBy    String    @map("assigned_by")
  assignedAt    DateTime  @default(now()) @map("assigned_at")
  expiresAt     DateTime? @map("expires_at")
  
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  permission    Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  assignedByUser User     @relation(fields: [assignedBy], references: [id])
  
  @@unique([userId, permissionId, contextType, contextId])
  @@map("user_permissions")
}

// ===== ENHANCED SHOP SYSTEM =====

model Shop {
    id              String    @id @default(uuid())

    // Basic info
    name            String    @map("shop_name")
    slug            String    @unique // URL-friendly identifier
    description     String?
    logo            String?
    banner          String?

    // Business information
    businessType    BusinessType @default(INDIVIDUAL) @map("business_type")
    businessName    String?   @map("business_name")
    businessLicense String?   @map("business_license")
    taxId           String?   @map("tax_id")

    // Contact information
    email           String    @unique @map("shop_email")
    phone           String?   @map("shop_phone")
    website         String?

    // Authentication (kept for backward compatibility)
    passwordHash    String?   @map("shop_password")
    salt            String?   @map("shop_salt")

    // Status and verification
    status          ShopStatus @default(PENDING)
    verificationStatus VerificationStatus @default(UNVERIFIED) @map("verification_status")
    verificationDocuments String[] @default([]) @map("verification_documents")

    // Financial
    commissionRate  Decimal   @default(0.05) @map("commission_rate") // Platform commission
    payoutSchedule  PayoutSchedule @default(WEEKLY) @map("payout_schedule")

    // Settings
    settings        Json      @default("{}")
    businessHours   Json?     @map("business_hours")
    shippingPolicies Json?    @map("shipping_policies")
    returnPolicies  Json?     @map("return_policies")

    // Analytics & metrics
    totalSales      Decimal   @default(0) @map("total_sales")
    totalOrders     Int       @default(0) @map("total_orders")
    averageRating   Decimal?  @map("average_rating")
    ratingCount     Int       @default(0) @map("rating_count")

    // Geographic info
    countryCode     String    @map("country_code")
    timezone        String    @default("UTC")
    currency        String    @default("USD")

    // Platform management
    featuredUntil   DateTime? @map("featured_until")
    suspendedUntil  DateTime? @map("suspended_until")
    suspensionReason String?  @map("suspension_reason")

    // Audit fields
    isActive        Boolean   @default(true) @map("is_active")
    createdAt       DateTime  @default(now()) @map("created_at")
    updatedAt       DateTime  @updatedAt @map("updated_at")
    approvedAt      DateTime? @map("approved_at")
    approvedBy      String?   @map("approved_by")

    // Relations
    keyTokens       ShopKeyToken[]
    apiKeys         APIKey[]
    staff           ShopStaff[]
    categories      ShopCategory[]
    products        Spu[]
    discounts       Discount[]
    orders          Order[]
    notifications   Notification[]
    messages        Message[] @relation("ShopMessages")
    reviews         ShopReview[]
    analytics       ShopAnalytics[]
    payouts         ShopPayout[]
    subscriptions   ShopSubscription[]
    addresses       ShopAddress[]
    campaigns       Campaign[]
    supportTickets  SupportTicket[]
    pages           Page[]
    blogPosts       BlogPost[]
    followers       UserFollow[] @relation("ShopFollowers")
    shippingMethods ShippingMethod[]
    webhooks        Webhook[]

    @@index([status])
    @@index([verificationStatus])
    @@index([countryCode])
    @@index([createdAt])
    @@map("shops")
}

model ShopAddress {
  id            String    @id @default(uuid())
  shopId        String    @map("shop_id")
  addressType   ShopAddressType @map("address_type")
  
  // Address components
  addressLine1  String    @map("address_line_1")
  addressLine2  String?   @map("address_line_2")
  city          String
  state         String?
  postalCode    String    @map("postal_code")
  countryCode   String    @map("country_code")
  
  // Contact info for this address
  contactName   String    @map("contact_name")
  contactPhone  String    @map("contact_phone")
  
  isPrimary     Boolean   @default(false) @map("is_primary")
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  
  @@index([shopId, addressType])
  @@map("shop_addresses")
}

model ShopStaff {
  id            String    @id @default(uuid())
  shopId        String    @map("shop_id")
  userId        String    @map("user_id")
  role          ShopStaffRole @map("role")
  
  // Permissions within shop
  permissions   Json      @default("{}") // Shop-specific permissions
  
  // Staff metadata
  position      String?
  department    String?
  salary        Decimal?
  
  // Access control
  canAccessFinancials Boolean @default(false) @map("can_access_financials")
  canManageStaff     Boolean @default(false) @map("can_manage_staff")
  canManageProducts  Boolean @default(false) @map("can_manage_products")
  
  // Invitation system
  invitedBy     String    @map("invited_by")
  invitedAt     DateTime  @default(now()) @map("invited_at")
  joinedAt      DateTime? @map("joined_at")
  
  status        StaffStatus @default(PENDING)
  
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  inviter       User      @relation(fields: [invitedBy], references: [id])
  
  @@unique([shopId, userId])
  @@index([userId])
  @@map("shop_staff")
}

model ShopCategory {
  id            String    @id @default(uuid())
  shopId        String    @map("shop_id")
  categoryId    Int       @map("category_id")
  
  // Approval system for selling in categories
  status        ApprovalStatus @default(PENDING)
  appliedAt     DateTime  @default(now()) @map("applied_at")
  reviewedAt    DateTime? @map("reviewed_at")
  reviewedBy    String?   @map("reviewed_by")
  reviewNotes   String?   @map("review_notes")
  
  // Category-specific settings
  commissionRate Decimal? @map("commission_rate") // Override default commission
  
  isActive      Boolean   @default(true) @map("is_active")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  shop          Shop      @relation(fields: [shopId], references: [id], onDelete: Cascade)
  category      Category  @relation(fields: [categoryId], references: [id])
  
  @@unique([shopId, categoryId])
  @@map("shop_categories")
}

// ===== ENHANCED PRODUCT SYSTEM =====

model Spu {
    id                    String          @id @default(uuid())
    shopId                String          @map("shop_id")
    
    // Basic product info
    name                  String          @db.VarChar(200)
    slug                  String          // URL-friendly identifier
    shortDescription      String?         @db.VarChar(500) @map("short_description")
    description           String?         @db.Text
    
    // Categorization
    brandId               Int?            @map("brand_id")
    primaryCategoryId     Int             @map("primary_category_id")
    secondaryCategoryIds  Int[]           @default([]) @map("secondary_category_ids")
    
    // Media
    images                String[]        @default([])
    videos                String[]        @default([])
    documents             String[]        @default([]) // Manuals, warranties, etc.
    
    // Product specifications
    attributes            Json            @default("{}")
    specifications        Json            @default("{}")
    dimensions            Json?           // Weight, size, etc.
    
    // Content management
    tags                  String[]        @default([])
    keywords              String[]        @default([]) // SEO keywords
    metaTitle             String?         @map("meta_title")
    metaDescription       String?         @map("meta_description")
    
    // Policies
    warrantyInfo          String?         @map("warranty_info")
    returnPolicy          String?         @map("return_policy")
    shippingPolicy        String?         @map("shipping_policy")
    
    // Status and moderation
    status                ProductStatus   @default(DRAFT)
    moderationStatus      ModerationStatus @default(PENDING) @map("moderation_status")
    moderationNotes       String?         @map("moderation_notes")
    
    // Publishing
    isPublished           Boolean         @default(false) @map("is_published")
    publishedAt           DateTime?       @map("published_at")
    featuredUntil         DateTime?       @map("featured_until")
    
    // Analytics
    viewCount             Int             @default(0) @map("view_count")
    wishlistCount         Int             @default(0) @map("wishlist_count")
    shareCount            Int             @default(0) @map("share_count")
    averageRating         Decimal?        @map("average_rating")
    reviewCount           Int             @default(0) @map("review_count")
    
    // SEO and search
    searchVector          String?         @map("search_vector") // Full-text search
    
    isActive              Boolean         @default(true) @map("is_active")
    createdAt             DateTime        @default(now()) @map("created_at")
    updatedAt             DateTime        @updatedAt @map("updated_at")
    moderatedAt           DateTime?       @map("moderated_at")
    moderatedBy           String?         @map("moderated_by")

    // Relations
    shop                  Shop            @relation(fields: [shopId], references: [id], onDelete: Cascade)
    brand                 Brand?          @relation(fields: [brandId], references: [id])
    primaryCategory       Category        @relation(fields: [primaryCategoryId], references: [id])
    skus                  Sku[]           @relation("SpuSkus")
    reviews               ProductReview[]
    comments              Comment[]
    wishlists             WishlistItem[]
    bundles               ProductBundle[] @relation("BundleProducts")
    bundleItems           ProductBundle[] @relation("BundleItems")
    crossSells            CrossSell[]     @relation("CrossSellFrom")
    crossSellTargets      CrossSell[]     @relation("CrossSellTo")
    recommendations       ProductRecommendation[]
    analytics             ProductAnalytics[]
    productSnapshots      ProductSnapshot[]

    

    
    @@unique([shopId, slug])
    @@index([shopId])
    @@index([primaryCategoryId])
    @@index([status])
    @@index([moderationStatus])
    @@index([createdAt])
    @@index([averageRating])
    @@fulltext([name, shortDescription]) // Full-text search
    @@map("products")
}

model Sku {
  id                String      @id @default(uuid())
  spuId             String      @map("spu_id")
  
  // SKU identification
  sku               String      @unique // Stock Keeping Unit identifier
  name              String      @db.VarChar(200)
  
  // Variant attributes (size, color, etc.)
  attributes        Json        @default("{}")
  
  // Pricing
  basePrice         Decimal     @map("base_price")
  salePrice         Decimal?    @map("sale_price")
  costPrice         Decimal?    @map("cost_price") // For profit calculation
  
  // Sale management
  saleStartDate     DateTime?   @map("sale_start_date")
  saleEndDate       DateTime?   @map("sale_end_date")
  
  // Media
  images            String[]    @default([])
  primaryImage      String?     @map("primary_image")
  
  // Physical properties
  weight            Decimal?
  dimensions        Json?       // length, width, height
  
  // Inventory tracking
  trackInventory    Boolean     @default(true) @map("track_inventory")
  inventoryPolicy   InventoryPolicy @default(DENY) @map("inventory_policy")
  
  // Status
  status            SkuStatus   @default(ACTIVE)
  isAvailable       Boolean     @default(true) @map("is_available")
  
  // Analytics
  salesCount        Int         @default(0) @map("sales_count")
  revenue           Decimal     @default(0)
  
  isActive          Boolean     @default(true) @map("is_active")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  // Relations
  spu               Spu         @relation("SpuSkus", fields: [spuId], references: [id], onDelete: Cascade)
  inventory         Inventory?
  cartItems         CartItem[]
  orderItems        OrderItem[]
  reservations      ReservationInventory[]
  priceHistory      PriceHistory[]
  
  @@index([spuId])
  @@index([status])
  @@index([basePrice])
  @@map("skus")
}

// ===== ENHANCED INVENTORY SYSTEM =====

model Inventory {
  id                String      @id @default(uuid())
  skuId             String      @unique @map("sku_id")
  
  // Stock levels
  quantity          Int         @default(0)
  reservedQuantity  Int         @default(0) @map("reserved_quantity")
  availableQuantity Int         @default(0) @map("available_quantity") // Computed field
  
  // Reorder management
  lowStockThreshold Int?        @map("low_stock_threshold")
  reorderLevel      Int?        @map("reorder_level")
  reorderQuantity   Int?        @map("reorder_quantity")
  
  // Multi-location support
  warehouseId       String?     @map("warehouse_id")
  binLocation       String?     @map("bin_location")
  
  // Batch/lot tracking
  batchNumber       String?     @map("batch_number")
  expirationDate    DateTime?   @map("expiration_date")
  manufactureDate   DateTime?   @map("manufacture_date")
  
  // Cost tracking
  averageCost       Decimal     @default(0) @map("average_cost")
  lastCost          Decimal?    @map("last_cost")
  
  // Audit fields
  lastStockCount    DateTime?   @map("last_stock_count")
  lastUpdatedBy     String?     @map("last_updated_by")
  
  isActive          Boolean     @default(true) @map("is_active")
  createdAt         DateTime    @default(now()) @map("created_at")
  updatedAt         DateTime    @updatedAt @map("updated_at")

  // Relations
  sku               Sku         @relation(fields: [skuId], references: [id], onDelete: Cascade)
  warehouse         Warehouse?  @relation(fields: [warehouseId], references: [id])
  movements         InventoryMovement[]
  reservations      ReservationInventory[]
  orderItems        OrderItem[]
  stockAlerts       StockAlert[]
  
  @@index([warehouseId])
  @@index([quantity])
  @@index([lowStockThreshold])
  @@map("inventories")
}

model Warehouse {
  id            String      @id @default(uuid())
  name          String
  code          String      @unique
  
  // Address info
  addressLine1  String      @map("address_line_1")
  addressLine2  String?     @map("address_line_2")
  city          String
  state         String?
  postalCode    String      @map("postal_code")
  countryCode   String      @map("country_code")
  
  // Contact info
  contactName   String      @map("contact_name")
  contactPhone  String      @map("contact_phone")
  contactEmail  String      @map("contact_email")
  
  // Operational info
  timezone      String      @default("UTC")
  operatingHours Json?      @map("operating_hours")
  
  // Capacity
  totalCapacity Float?      @map("total_capacity")
  usedCapacity  Float       @default(0) @map("used_capacity")
  
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  inventories   Inventory[]
  movements     InventoryMovement[]
  
  @@map("warehouses")
}

model InventoryMovement {
  id            String      @id @default(uuid())
  inventoryId   String      @map("inventory_id")
  warehouseId   String?     @map("warehouse_id")
  
  movementType  MovementType @map("movement_type")
  quantity      Int
  
  // Reference to source transaction
  referenceType String?     @map("reference_type") // order, return, adjustment, transfer
  referenceId   String?     @map("reference_id")
  
  // Cost impact
  unitCost      Decimal?    @map("unit_cost")
  totalCost     Decimal?    @map("total_cost")
  
  reason        String?
  notes         String?
  
  // Audit info
  performedBy   String      @map("performed_by")
  performedAt   DateTime    @default(now()) @map("performed_at")
  
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  inventory     Inventory   @relation(fields: [inventoryId], references: [id])
  warehouse     Warehouse?  @relation(fields: [warehouseId], references: [id])
  performer     User        @relation(fields: [performedBy], references: [id])
  
  @@index([inventoryId])
  @@index([movementType])
  @@index([performedAt])
  @@map("inventory_movements")
}

model ReservationInventory {
  id            String      @id @default(uuid())
  inventoryId   String      @map("inventory_id")
  userId        String      @map("user_id")
  
  quantity      Int
  reservedAt    DateTime    @default(now()) @map("reserved_at")
  expiresAt     DateTime    @map("expires_at")
  
  // Reservation context
  reservationType ReservationType @map("reservation_type")
  referenceId   String?     @map("reference_id") // Cart ID, Order ID, etc.
  
  status        ReservationStatus @default(ACTIVE)
  
  // Fulfillment tracking
  fulfilledQuantity Int     @default(0) @map("fulfilled_quantity")
  cancelledQuantity Int     @default(0) @map("cancelled_quantity")
  
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  inventory     Inventory   @relation(fields: [inventoryId], references: [id])
  user          User        @relation(fields: [userId], references: [id])
  
  @@unique([inventoryId, userId, referenceId])
  @@index([expiresAt])
  @@index([status])
  @@map("reservation_inventories")
}

model StockAlert {
  id            String      @id @default(uuid())
  inventoryId   String      @map("inventory_id")
  alertType     StockAlertType @map("alert_type")
  
  threshold     Int
  currentLevel  Int          @map("current_level")
  
  status        AlertStatus  @default(ACTIVE)
  acknowledgedAt DateTime?   @map("acknowledged_at")
  acknowledgedBy String?     @map("acknowledged_by")
  
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  inventory     Inventory   @relation(fields: [inventoryId], references: [id])
  acknowledger  User?       @relation(fields: [acknowledgedBy], references: [id])
  
  @@index([status])
  @@index([alertType])
  @@map("stock_alerts")
}

// ===== ENHANCED ORDER SYSTEM =====

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique @map("order_number") // Human-readable order number
  userId          String        @map("user_id")
  shopId          String?       @map("shop_id") // Null for multi-vendor orders
  
  // Order status and workflow
  status          OrderStatus   @default(PENDING)
  fulfillmentStatus FulfillmentStatus @default(UNFULFILLED) @map("fulfillment_status")
  paymentStatus   PaymentStatus @default(PENDING) @map("payment_status")
  
  // Financial information
  subtotal        Decimal
  taxAmount       Decimal       @default(0) @map("tax_amount")
  shippingFee     Decimal       @default(0) @map("shipping_fee")
  discountAmount  Decimal       @default(0) @map("discount_amount")
  totalAmount     Decimal       @map("total_amount")
  
  // Currency and localization
  currency        String        @default("USD")
  exchangeRate    Decimal?      @map("exchange_rate")
  
  // Shipping information
  shippingAddressId String?     @map("shipping_address_id")
  billingAddressId  String?     @map("billing_address_id")
  shippingMethod    String?     @map("shipping_method")
  shippingProvider  String?     @map("shipping_provider")
  trackingNumber    String?     @map("tracking_number")
  
  // Delivery preferences
  deliveryInstructions String? @map("delivery_instructions")
  signatureRequired    Boolean @default(false) @map("signature_required")
  leaveAtDoor         Boolean @default(false) @map("leave_at_door")
  
  // Payment information
  paymentMethodId   String?     @map("payment_method_id")
  paymentProvider   String?     @map("payment_provider")
  paymentIntentId   String?     @map("payment_intent_id")
  transactionId     String?     @map("transaction_id")
  
  // Discount and promotion
  discountCodes     String[]    @default([]) @map("discount_codes")
  loyaltyPointsUsed Int         @default(0) @map("loyalty_points_used")
  
  // Dates and timelines
  estimatedDelivery DateTime?   @map("estimated_delivery")
  requestedDelivery DateTime?   @map("requested_delivery")
  shippedAt         DateTime?   @map("shipped_at")
  deliveredAt       DateTime?   @map("delivered_at")
  cancelledAt       DateTime?   @map("cancelled_at")
  returnedAt        DateTime?   @map("returned_at")
  
  // Order metadata
  channel           OrderChannel @default(WEB)
  source            String?      // utm_source, referral, etc.
  customerNotes     String?      @map("customer_notes")
  internalNotes     String?      @map("internal_notes")
  
  // Risk and fraud
  riskScore         Float?       @map("risk_score")
  fraudStatus       FraudStatus? @map("fraud_status")
  
  // Expiration for pending orders
  expiresAt         DateTime?    @map("expires_at")
  
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  // Relations
  user              User         @relation(fields: [userId], references: [id])
  shop              Shop?        @relation(fields: [shopId], references: [id])
  shippingAddress   UserAddress? @relation(fields: [shippingAddressId], references: [id])
  paymentMethod     PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  
  orderItems        OrderItem[]
  statusHistory     OrderStatusHistory[]
  shipments         Shipment[]
  returns           OrderReturn[]
  refunds           Refund[]
  invoices          Invoice[]
  
  @@index([userId])
  @@index([shopId])
  @@index([status])
  @@index([createdAt])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id              String      @id @default(uuid())
  orderId         String      @map("order_id")
  skuId           String      @map("sku_id")
  inventoryId     String?     @map("inventory_id")
  
  // Product info (snapshot at time of order)
  productName     String      @map("product_name")
  productImage    String?     @map("product_image")
//   sku             String      // SKU code
  
  // Pricing (at time of order)
  unitPrice       Decimal     @map("unit_price")
  salePrice       Decimal?    @map("sale_price")
  quantity        Int
  subtotal        Decimal
  
  // Discounts applied to this item
  discountAmount  Decimal     @default(0) @map("discount_amount")
  taxAmount       Decimal     @default(0) @map("tax_amount")
  totalAmount     Decimal     @map("total_amount")
  
  // Fulfillment tracking
  fulfilledQuantity Int       @default(0) @map("fulfilled_quantity")
  shippedQuantity   Int       @default(0) @map("shipped_quantity")
  deliveredQuantity Int       @default(0) @map("delivered_quantity")
  returnedQuantity  Int       @default(0) @map("returned_quantity")
  cancelledQuantity Int       @default(0) @map("cancelled_quantity")
  
  // Item-specific attributes
  productAttributes Json?     @map("product_attributes")
  customizations     Json?     // Custom engravings, etc.
  
  // Status
  status          OrderItemStatus @default(PENDING)
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relations
  order           Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sku             Sku         @relation(fields: [skuId], references: [id])
  inventory       Inventory?  @relation(fields: [inventoryId], references: [id])
  
  shipmentItems   ShipmentItem[]
  returnItems     ReturnItem[]
  
  @@index([orderId])
  @@index([skuId])
  @@map("order_items")
}

model OrderStatusHistory {
  id            String      @id @default(uuid())
  orderId       String      @map("order_id")
  
  fromStatus    OrderStatus? @map("from_status")
  toStatus      OrderStatus  @map("to_status")
  
  reason        String?
  notes         String?
  changedBy     String      @map("changed_by")
  changedAt     DateTime    @default(now()) @map("changed_at")
  
  // Notification tracking
  customerNotified Boolean  @default(false) @map("customer_notified")
  vendorNotified   Boolean  @default(false) @map("vendor_notified")
  
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changer       User        @relation(fields: [changedBy], references: [id])
  
  @@index([orderId])
  @@index([changedAt])
  @@map("order_status_history")
}

// ===== ENHANCED CART SYSTEM =====

model Cart {
  id              String        @id @default(uuid())
  userId          String        @unique @map("user_id")
  sessionId       String?       @map("session_id") // For guest carts
  
  status          CartStatus    @default(ACTIVE)
  
  // Cart totals (computed but cached for performance)
  itemCount       Int           @default(0) @map("item_count")
  subtotal        Decimal       @default(0)
  taxAmount       Decimal       @default(0) @map("tax_amount")
  discountAmount  Decimal       @default(0) @map("discount_amount")
  shippingFee     Decimal       @default(0) @map("shipping_fee")
  totalAmount     Decimal       @default(0) @map("total_amount")
  
  // Applied promotions
  discountCodes   String[]      @default([]) @map("discount_codes")
  
  // Cart preferences
  currency        String        @default("USD")
  shippingAddressId String?     @map("shipping_address_id")
  
  // Expiration (for abandoned cart recovery)
  expiresAt       DateTime?     @map("expires_at")
  lastActivity    DateTime      @default(now()) @map("last_activity")
  
  // Conversion tracking
  convertedAt     DateTime?     @map("converted_at")
  orderId         String?       @map("order_id")
  
  isActive        Boolean       @default(true) @map("is_active")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  shippingAddress UserAddress?  @relation(fields: [shippingAddressId], references: [id])
  
  items           CartItem[]
  
  @@index([sessionId])
  @@index([status])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id              String      @id @default(uuid())
  cartId          String      @map("cart_id")
  skuId           String      @map("sku_id")
  
  quantity        Int
  
  // Price at time of adding to cart
  unitPrice       Decimal     @map("unit_price")
  subtotal        Decimal
  
  // Customizations
  customizations  Json?
  personalizations Json?
  
  // Wishlist crossover
  savedForLater   Boolean     @default(false) @map("saved_for_later")
  
  addedAt         DateTime    @default(now()) @map("added_at")
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  cart            Cart        @relation(fields: [cartId], references: [id], onDelete: Cascade)
  sku             Sku         @relation(fields: [skuId], references: [id])
  
  @@unique([cartId, skuId])
  @@index([cartId])
  @@map("cart_items")
}

// ===== PAYMENT SYSTEM =====

model PaymentMethod {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  
  type            PaymentType
  provider        String      // stripe, paypal, etc.
  
  // Card details (encrypted/tokenized)
  cardLast4       String?     @map("card_last_4")
  cardBrand       String?     @map("card_brand")
  cardExpMonth    Int?        @map("card_exp_month")
  cardExpYear     Int?        @map("card_exp_year")
  
  // External IDs
  providerCustomerId String?  @map("provider_customer_id")
  providerMethodId   String?  @map("provider_method_id")
  
  // Billing info
  billingAddressId String?    @map("billing_address_id")
  
  // Status
  isDefault       Boolean     @default(false) @map("is_default")
  isVerified      Boolean     @default(false) @map("is_verified")
  
  // Security
  fingerprint     String?     // For duplicate detection
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  lastUsedAt      DateTime?   @map("last_used_at")

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  billingAddress  UserAddress? @relation(fields: [billingAddressId], references: [id])
  
  orders          Order[]
  transactions    PaymentTransaction[]
  
  @@index([userId])
  @@index([type])
  @@map("payment_methods")
}

model PaymentTransaction {
  id              String      @id @default(uuid())
  paymentMethodId String?     @map("payment_method_id")
  orderId         String?     @map("order_id")
  
  type            TransactionType
  status          TransactionStatus
  
  amount          Decimal
  currency        String      @default("USD")
  
  // Provider details
  provider        String
  providerTransactionId String? @map("provider_transaction_id")
  providerStatus  String?     @map("provider_status")
  providerResponse Json?      @map("provider_response")
  
  // Transaction metadata
  description     String?
  metadata        Json?
  
  // Dates
  authorizedAt    DateTime?   @map("authorized_at")
  capturedAt      DateTime?   @map("captured_at")
  settledAt       DateTime?   @map("settled_at")
  failedAt        DateTime?   @map("failed_at")
  refundedAt      DateTime?   @map("refunded_at")
  
  // Failure info
  failureCode     String?     @map("failure_code")
  failureMessage  String?     @map("failure_message")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  paymentMethod   PaymentMethod? @relation(fields: [paymentMethodId], references: [id])
  order           Order?      @relation(fields: [orderId], references: [id])
  
  refunds         Refund[]
  
  @@index([orderId])
  @@index([status])
  @@index([createdAt])
  @@map("payment_transactions")
}

// ===== USER FINANCIAL SYSTEM =====

model UserWallet {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  
  walletType      WalletType  @map("wallet_type")
  currency        String      @default("USD")
  
  balance         Decimal     @default(0)
  pendingBalance  Decimal     @default(0) @map("pending_balance")
  frozenBalance   Decimal     @default(0) @map("frozen_balance")
  
  // Limits
  dailySpendLimit  Decimal?   @map("daily_spend_limit")
  monthlySpendLimit Decimal?  @map("monthly_spend_limit")
  
  status          WalletStatus @default(ACTIVE)
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions    WalletTransaction[]
  
  @@unique([userId, walletType, currency])
  @@index([userId])
  @@map("user_wallets")
}

model WalletTransaction {
  id              String      @id @default(uuid())
  walletId        String      @map("wallet_id")
  
  type            WalletTransactionType
  amount          Decimal
  
  // Balance tracking
  balanceBefore   Decimal     @map("balance_before")
  balanceAfter    Decimal     @map("balance_after")
  
  // Reference to source transaction
  referenceType   String?     @map("reference_type")
  referenceId     String?     @map("reference_id")
  
  description     String?
  metadata        Json?
  
  status          TransactionStatus @default(COMPLETED)
  
  processedAt     DateTime?   @map("processed_at")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  wallet          UserWallet  @relation(fields: [walletId], references: [id])
  
  @@index([walletId])
  @@index([type])
  @@index([createdAt])
  @@map("wallet_transactions")
}

// ===== LOYALTY & REWARDS SYSTEM =====

model LoyaltyProgram {
  id              String      @id @default(uuid())
  name            String
  description     String?
  
  programType     LoyaltyType @map("program_type")
  
  // Program rules
  pointsPerDollar Decimal     @map("points_per_dollar")
  minimumOrder    Decimal?    @map("minimum_order")
  
  // Tier settings
  tiers           Json?       // Tier configuration
  
  // Validity
  startDate       DateTime    @map("start_date")
  endDate         DateTime?   @map("end_date")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  userPrograms    UserLoyaltyProgram[]
  
  @@map("loyalty_programs")
}

model UserLoyaltyProgram {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  programId       String      @map("program_id")
  
  currentPoints   Int         @default(0) @map("current_points")
  totalEarned     Int         @default(0) @map("total_earned")
  totalRedeemed   Int         @default(0) @map("total_redeemed")
  
  currentTier     String?     @map("current_tier")
  tierExpiresAt   DateTime?   @map("tier_expires_at")
  
  joinedAt        DateTime    @default(now()) @map("joined_at")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user            User        @relation(fields: [userId], references: [id])
  program         LoyaltyProgram @relation(fields: [programId], references: [id])
  
  transactions    LoyaltyTransaction[]
  
  @@unique([userId, programId])
  @@map("user_loyalty_programs")
}

model LoyaltyTransaction {
  id              String      @id @default(uuid())
  userProgramId   String      @map("user_program_id")
  
  type            LoyaltyTransactionType
  points          Int
  
  // Balance tracking
  pointsBefore    Int         @map("points_before")
  pointsAfter     Int         @map("points_after")
  
  // Reference
  referenceType   String?     @map("reference_type")
  referenceId     String?     @map("reference_id")
  
  description     String?
  expiresAt       DateTime?   @map("expires_at")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  userProgram     UserLoyaltyProgram @relation(fields: [userProgramId], references: [id])
  
  @@index([userProgramId])
  @@index([type])
  @@map("loyalty_transactions")
}

// ===== ENHANCED REVIEW & RATING SYSTEM =====

model ProductReview {
  id              String      @id @default(uuid())
  productId       String      @map("product_id")
  userId          String      @map("user_id")
  orderId         String?     @map("order_id") // Verified purchase
  
  rating          Int         // 1-5 stars
  title           String?
  content         String?     @db.Text
  
  // Review attributes
  pros            String[]    @default([])
  cons            String[]    @default([])
  
  // Media attachments
  images          String[]    @default([])
  videos          String[]    @default([])
  
  // Verification
  isVerifiedPurchase Boolean  @default(false) @map("is_verified_purchase")
  
  // Moderation
  status          ReviewStatus @default(PENDING)
  moderatedAt     DateTime?   @map("moderated_at")
  moderatedBy     String?     @map("moderated_by")
  moderationNotes String?     @map("moderation_notes")
  
  // Helpfulness voting
  helpfulVotes    Int         @default(0) @map("helpful_votes")
  totalVotes      Int         @default(0) @map("total_votes")
  
  // Response from seller
  sellerResponse  String?     @map("seller_response")
  sellerRespondedAt DateTime? @map("seller_responded_at")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  product         Spu         @relation(fields: [productId], references: [id])
  user            User        @relation(fields: [userId], references: [id])
  order           Order?      @relation(fields: [orderId], references: [id])
  
  votes           ReviewHelpfulVote[]
  
  @@unique([productId, userId, orderId])
  @@index([productId])
  @@index([rating])
  @@index([status])
  @@map("product_reviews")
}

model ReviewHelpfulVote {
  id              String      @id @default(uuid())
  reviewId        String      @map("review_id")
  userId          String      @map("user_id")
  
  isHelpful       Boolean     @map("is_helpful")
  
  createdAt       DateTime    @default(now()) @map("created_at")

  review          ProductReview @relation(fields: [reviewId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id])
  
  @@unique([reviewId, userId])
  @@map("review_helpful_votes")
}

model ShopReview {
  id              String      @id @default(uuid())
  shopId          String      @map("shop_id")
  userId          String      @map("user_id")
  orderId         String?     @map("order_id")
  
  rating          Int         // 1-5 stars
  title           String?
  content         String?     @db.Text
  
  // Review categories
  productQuality  Int?        @map("product_quality")
  shipping        Int?
  customerService Int?        @map("customer_service")
  
  status          ReviewStatus @default(PENDING)
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  shop            Shop        @relation(fields: [shopId], references: [id])
  
  @@index([shopId])
  @@index([status])
  @@map("shop_reviews")
}

// ===== PRODUCT CATALOG ENHANCEMENTS =====

model Category {
  id              Int         @id @default(autoincrement())
  name            String      @db.VarChar(100)
  slug            String      @unique
  description     String?     @db.Text
  
  // Hierarchy
  parentId        Int?        @map("parent_id")
  level           Int         @default(0)
  path            String?     // Materialized path for faster queries
  
  // Display
  image           String?
  icon            String?
  sort            Int         @default(0)
  
  // SEO
  metaTitle       String?     @map("meta_title")
  metaDescription String?     @map("meta_description")
  
  // Commerce settings
  commissionRate  Decimal?    @map("commission_rate")
  requiresApproval Boolean    @default(false) @map("requires_approval")
  
  // Status
  isActive        Boolean     @default(true) @map("is_active")
  isVisible       Boolean     @default(true) @map("is_visible")
  
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relations
  parent          Category?   @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children        Category[]  @relation("CategoryHierarchy")
  
  products        Spu[]
  brands          CategoryBrand[]
  attributes      CategoryAttribute[]
  shopCategories  ShopCategory[]
  
  @@index([parentId])
  @@index([slug])
  @@index([isActive, isVisible])
  @@map("categories")
}

model Brand {
  id              Int         @id @default(autoincrement())
  name            String      @db.VarChar(100)
  slug            String      @unique
  description     String?     @db.Text
  
  // Media
  logo            String?
  banner          String?
  
  // Brand info
  website         String?
  foundedYear     Int?        @map("founded_year")
  country         String?
  
  // Display
  initial         String?     @db.VarChar(1) // For alphabetical grouping
  sort            Int         @default(0)
  
  // SEO
  metaTitle       String?     @map("meta_title")
  metaDescription String?     @map("meta_description")
  
  // Status
  isActive        Boolean     @default(true) @map("is_active")
  isFeatured      Boolean     @default(false) @map("is_featured")
  
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relations
  products        Spu[]
  categories      CategoryBrand[]
  
  @@index([slug])
  @@index([isActive])
  @@index([initial])
  @@map("brands")
}

model CategoryBrand {
  categoryId      Int         @map("category_id")
  brandId         Int         @map("brand_id")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")

  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  brand           Brand       @relation(fields: [brandId], references: [id], onDelete: Cascade)
  
  @@id([categoryId, brandId])
  @@map("category_brands")
}

model CategoryAttribute {
  id              String      @id @default(uuid())
  categoryId      Int         @map("category_id")
  attributeId     String      @map("attribute_id")
  
  isRequired      Boolean     @default(false) @map("is_required")
  isFilterable    Boolean     @default(true) @map("is_filterable")
  displayOrder    Int         @default(0) @map("display_order")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  category        Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  attribute       ProductAttribute @relation(fields: [attributeId], references: [id], onDelete: Cascade)
  
  @@unique([categoryId, attributeId])
  @@map("category_attributes")
}

model ProductAttribute {
  id              String      @id @default(uuid())
  name            String      @db.VarChar(100)
  slug            String      @unique
  
  type            AttributeType // TEXT, NUMBER, SELECT, MULTI_SELECT, BOOLEAN, DATE
  unit            String?     // kg, cm, etc.
  
  // For select types
  options         Json?       // Array of possible values
  
  // Validation
  isRequired      Boolean     @default(false) @map("is_required")
  minValue        Decimal?    @map("min_value")
  maxValue        Decimal?    @map("max_value")
  pattern         String?     // Regex pattern
  
  // Display
  displayName     String      @map("display_name")
  description     String?
  helpText        String?     @map("help_text")
  sort            Int         @default(0)
  
  // Functionality
  isFilterable    Boolean     @default(true) @map("is_filterable")
  isSearchable    Boolean     @default(false) @map("is_searchable")
  isComparable    Boolean     @default(false) @map("is_comparable")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  categories      CategoryAttribute[]
  
  @@index([slug])
  @@index([type])
  @@map("product_attributes")
}

// ===== SEARCH & RECOMMENDATIONS =====

model SearchQuery {
  id              String      @id @default(uuid())
  userId          String?     @map("user_id")
  sessionId       String?     @map("session_id")
  
  query           String
  normalizedQuery String     @map("normalized_query") // For analytics
  
  // Context
  categoryId      Int?        @map("category_id")
  filters         Json?       // Applied filters
  sortBy          String?     @map("sort_by")
  
  // Results
  resultCount     Int         @default(0) @map("result_count")
  clickedResults  String[]    @default([]) @map("clicked_results")
  
  // Geographic context
  country         String?
  region          String?
  
  searchedAt      DateTime    @default(now()) @map("searched_at")

  user            User?       @relation(fields: [userId], references: [id])
  
  @@index([normalizedQuery])
  @@index([searchedAt])
  @@index([userId])
  @@map("search_queries")
}

// ===== CONTENT MANAGEMENT =====

model Comment {
  id              String      @id @default(uuid())
  productId       String      @map("product_id")
  userId          String      @map("user_id")
  
  content         String      @db.Text
  
  // Nested comments (using nested set model)
  leftBound       Int         @default(0) @map("left_bound")
  rightBound      Int         @default(0) @map("right_bound")
  parentId        String?     @map("parent_id")
  depth           Int         @default(0)
  
  // Moderation
  status          CommentStatus @default(PENDING)
  moderatedAt     DateTime?   @map("moderated_at")
  moderatedBy     String?     @map("moderated_by")
  
  // Interaction
  likesCount      Int         @default(0) @map("likes_count")
  dislikesCount   Int         @default(0) @map("dislikes_count")
  
  // Flags
  isDeleted       Boolean     @default(false) @map("is_deleted")
  isPinned        Boolean     @default(false) @map("is_pinned")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  product         Spu         @relation(fields: [productId], references: [id])
  user            User        @relation(fields: [userId], references: [id])
  parent          Comment?    @relation("CommentReplies", fields: [parentId], references: [id])
  replies         Comment[]   @relation("CommentReplies")
  
  likes           CommentLike[]
  
  @@index([productId])
  @@index([userId])
  @@index([leftBound, rightBound])
  @@index([status])
  @@map("comments")
}

model CommentLike {
  id              String      @id @default(uuid())
  commentId       String      @map("comment_id")
  userId          String      @map("user_id")
  
  isLike          Boolean     @map("is_like") // true = like, false = dislike
  
  createdAt       DateTime    @default(now()) @map("created_at")

  comment         Comment     @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id])
  
  @@unique([commentId, userId])
  @@map("comment_likes")
}

