// ===== FINAL PART: ADVANCED FEATURES & OPTIMIZATIONS =====

// ===== RECOMMENDATION ENGINE =====

model RecommendationEngine {
  id              String      @id @default(uuid())
  name            String
  description     String?
  algorithm       String      // collaborative_filtering, content_based, hybrid
  
  // Configuration
  config          Json        // Algorithm-specific parameters
  
  // Performance metrics
  accuracy        Float?
  precision       Float?
  recall          Float?
  f1Score         Float?      @map("f1_score")
  
  // Status
  status          EngineStatus @default(TRAINING)
  lastTrainedAt   DateTime?   @map("last_trained_at")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  recommendations ProductRecommendation[]
  
  @@map("recommendation_engines")
}

model ProductRecommendation {
  id              String      @id @default(uuid())
  engineId        String      @map("engine_id")
  userId          String      @map("user_id")
  
  recommendedProductId String  @map("recommended_product_id")
  score           Float       // Confidence score
  reason          String?     // Why this was recommended
  
  // Context
  context         Json?       // Page, category, session data
  position        Int?        // Position in recommendation list
  
  // Interaction tracking
  viewed          Boolean     @default(false)
  clicked         Boolean     @default(false)
  purchased       Boolean     @default(false)
  
  // A/B testing
  experimentId    String?     @map("experiment_id")
  variant         String?
  
  expiresAt       DateTime    @map("expires_at")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  engine          RecommendationEngine @relation(fields: [engineId], references: [id])
  user            User        @relation(fields: [userId], references: [id])
  product         Spu         @relation(fields: [recommendedProductId], references: [id])
  
  @@unique([engineId, userId, recommendedProductId])
  @@index([userId, expiresAt])
  @@index([experimentId])
  @@map("product_recommendations")
}

// ===== A/B TESTING FRAMEWORK =====

model ABTest {
  id              String      @id @default(uuid())
  name            String
  description     String?
  hypothesis      String?
  
  // Test configuration
  testType        TestType    @map("test_type")
  trafficSplit    Json        // Percentage allocation per variant
  
  // Targeting
  targetAudience  Json?       @map("target_audience")
  
  // Duration
  startDate       DateTime    @map("start_date")
  endDate         DateTime    @map("end_date")
  
  // Statistical settings
  confidenceLevel Float       @default(0.95) @map("confidence_level")
  minSampleSize   Int         @map("min_sample_size")
  
  // Results
  winner          String?     // Winning variant
  significance    Float?      // Statistical significance
  results         Json?       // Detailed test results
  
  status          TestStatus  @default(DRAFT)
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  variants        ABTestVariant[]
  assignments     ABTestAssignment[]
  metrics         ABTestMetric[]
  
  @@map("ab_tests")
}

model ABTestVariant {
  id              String      @id @default(uuid())
  testId          String      @map("test_id")
  
  name            String      // Control, Variant A, etc.
  description     String?
  configuration   Json        // What changes in this variant
  
  trafficPercent  Float       @map("traffic_percent")
  
  // Metrics
  users           Int         @default(0)
  conversions     Int         @default(0)
  conversionRate  Float       @default(0) @map("conversion_rate")
  revenue         Decimal     @default(0)
  
  isControl       Boolean     @default(false) @map("is_control")
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  test            ABTest      @relation(fields: [testId], references: [id], onDelete: Cascade)
  assignments     ABTestAssignment[]
  
  @@unique([testId, name])
  @@map("ab_test_variants")
}

model ABTestAssignment {
  id              String      @id @default(uuid())
  testId          String      @map("test_id")
  variantId       String      @map("variant_id")
  userId          String      @map("user_id")
  
  assignedAt      DateTime    @default(now()) @map("assigned_at")
  
  // Outcome tracking
  converted       Boolean     @default(false)
  convertedAt     DateTime?   @map("converted_at")
  conversionValue Decimal?    @map("conversion_value")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  test            ABTest      @relation(fields: [testId], references: [id], onDelete: Cascade)
  variant         ABTestVariant @relation(fields: [variantId], references: [id])
  user            User        @relation(fields: [userId], references: [id])
  
  @@unique([testId, userId])
  @@index([variantId])
  @@map("ab_test_assignments")
}

model ABTestMetric {
  id              String      @id @default(uuid())
  testId          String      @map("test_id")
  variantId       String      @map("variant_id")
  
  metricName      String      @map("metric_name")
  metricValue     Float       @map("metric_value")
  
  recordedAt      DateTime    @default(now()) @map("recorded_at")

  test            ABTest      @relation(fields: [testId], references: [id], onDelete: Cascade)
  
  @@index([testId, variantId, metricName])
  @@map("ab_test_metrics")
}

// ===== FRAUD DETECTION =====

model FraudRule {
  id              String      @id @default(uuid())
  name            String
  description     String?
  
  ruleType        FraudRuleType @map("rule_type")
  conditions      Json        // Rule conditions in JSON format
  
  // Scoring
  riskScore       Int         @map("risk_score") // 0-100
  action          FraudAction // ALLOW, FLAG, BLOCK
  
  // Performance tracking
  triggeredCount  Int         @default(0) @map("triggered_count")
  falsePositives  Int         @default(0) @map("false_positives")
  accuracy        Float?
  
  priority        Int         @default(0)
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  alerts          FraudAlert[]
  
  @@index([ruleType])
  @@index([priority])
  @@map("fraud_rules")
}

model FraudAlert {
  id              String      @id @default(uuid())
  ruleId          String      @map("rule_id")
  orderId         String?     @map("order_id")
  userId          String?     @map("user_id")
  
  alertType       FraudAlertType @map("alert_type")
  riskScore       Int         @map("risk_score")
  details         Json        // What triggered the alert
  
  status          AlertStatus @default(ACTIVE)
  
  // Investigation
  investigatedBy  String?     @map("investigated_by")
  investigatedAt  DateTime?   @map("investigated_at")
  resolution      String?
  notes           String?
  
  // Actions taken
  actionTaken     FraudAction? @map("action_taken")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  rule            FraudRule   @relation(fields: [ruleId], references: [id])
  order           Order?      @relation(fields: [orderId], references: [id])
  user            User?       @relation(fields: [userId], references: [id])
  investigator    User?       @relation("FraudInvestigator", fields: [investigatedBy], references: [id])
  
  @@index([status])
  @@index([riskScore])
  @@map("fraud_alerts")
}

// ===== BUSINESS INTELLIGENCE =====

model KPIMetric {
  id              String      @id @default(uuid())
  name            String      // revenue, conversion_rate, customer_acquisition_cost
  displayName     String      @map("display_name")
  description     String?
  
  category        MetricCategory
  dataType        MetricDataType @map("data_type")
  unit            String?     // currency, percentage, count
  
  // Calculation
  query           String      @db.Text // SQL query to calculate metric
  refreshInterval Int         @map("refresh_interval") // Minutes
  
  // Formatting
  formatPattern   String?     @map("format_pattern")
  
  // Targets/Goals
  target          Float?
  warningThreshold Float?     @map("warning_threshold")
  criticalThreshold Float?    @map("critical_threshold")
  
  // Permissions
  visibility      MetricVisibility @default(PRIVATE)
  allowedRoles    String[]    @default([]) @map("allowed_roles")
  
  lastCalculated  DateTime?   @map("last_calculated")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  values          KPIValue[]
  dashboards      DashboardWidget[]
  
  @@index([category])
  @@index([lastCalculated])
  @@map("kpi_metrics")
}

model KPIValue {
  id              String      @id @default(uuid())
  metricId        String      @map("metric_id")
  
  value           Float
  timestamp       DateTime
  
  // Dimensions for segmentation
  dimensions      Json?       // shop_id, category_id, etc.
  
  createdAt       DateTime    @default(now()) @map("created_at")

  metric          KPIMetric   @relation(fields: [metricId], references: [id], onDelete: Cascade)
  
  @@unique([metricId, timestamp, dimensions])
  @@index([timestamp])
  @@map("kpi_values")
}

model Dashboard {
  id              String      @id @default(uuid())
  name            String
  description     String?
  
  // Layout
  layout          Json        // Grid layout configuration
  
  // Access control
  ownerId         String      @map("owner_id")
  visibility      DashboardVisibility @default(PRIVATE)
  sharedWith      String[]    @default([]) @map("shared_with")
  
  // Display settings
  refreshInterval Int?        @map("refresh_interval") // Auto-refresh in minutes
  
  isDefault       Boolean     @default(false) @map("is_default")
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  owner           User        @relation(fields: [ownerId], references: [id])
  widgets         DashboardWidget[]
  
  @@index([ownerId])
  @@index([visibility])
  @@map("dashboards")
}

model DashboardWidget {
  id              String      @id @default(uuid())
  dashboardId     String      @map("dashboard_id")
  metricId        String?     @map("metric_id")
  
  title           String
  widgetType      WidgetType  @map("widget_type")
  
  // Position and size
  gridPosition    Json        @map("grid_position") // x, y, width, height
  
  // Configuration
  config          Json        // Widget-specific settings
  
  // Data filtering
  filters         Json?       // Date range, segments, etc.
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  dashboard       Dashboard   @relation(fields: [dashboardId], references: [id], onDelete: Cascade)
  metric          KPIMetric?  @relation(fields: [metricId], references: [id])
  
  @@index([dashboardId])
  @@map("dashboard_widgets")
}

// ===== MULTI-CURRENCY & LOCALIZATION =====

model Currency {
  id              String      @id @default(uuid())
  code            String      @unique // USD, EUR, GBP
  name            String      // US Dollar
  symbol          String      // $
  
  // Exchange rates (base currency is configurable)
  exchangeRate    Decimal     @map("exchange_rate")
  lastUpdated     DateTime    @map("last_updated")
  
  // Formatting
  decimalPlaces   Int         @default(2) @map("decimal_places")
  symbolPosition  SymbolPosition @map("symbol_position") // BEFORE, AFTER
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  rates           ExchangeRate[]
  
  @@map("currencies")
}

model ExchangeRate {
  id              String      @id @default(uuid())
  fromCurrencyId  String      @map("from_currency_id")
  toCurrencyId    String      @map("to_currency_id")
  
  rate            Decimal
  source          String      // API source
  
  effectiveAt     DateTime    @map("effective_at")
  
  createdAt       DateTime    @default(now()) @map("created_at")

  fromCurrency    Currency    @relation(fields: [fromCurrencyId], references: [id])
  
  @@unique([fromCurrencyId, toCurrencyId, effectiveAt])
  @@index([effectiveAt])
  @@map("exchange_rates")
}

model Translation {
  id              String      @id @default(uuid())
  namespace       String      // product, category, ui
  key             String      // product.name, category.description
  locale          String      // en-US, es-ES, fr-FR
  
  value           String      @db.Text
  
  // Context
  resourceType    String?     @map("resource_type")
  resourceId      String?     @map("resource_id")
  
  // Quality assurance
  isReviewed      Boolean     @default(false) @map("is_reviewed")
  reviewedBy      String?     @map("reviewed_by")
  reviewedAt      DateTime?   @map("reviewed_at")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  reviewer        User?       @relation(fields: [reviewedBy], references: [id])
  
  @@unique([namespace, key, locale])
  @@index([namespace, locale])
  @@index([resourceType, resourceId])
  @@map("translations")
}

// ===== AUTOMATION & WORKFLOWS =====

model Workflow {
  id              String      @id @default(uuid())
  name            String
  description     String?
  
  trigger         WorkflowTrigger
  triggerConfig   Json        @map("trigger_config") // Event conditions
  
  // Workflow definition
  steps           Json        // Array of workflow steps
  
  // Execution settings
  isEnabled       Boolean     @default(true) @map("is_enabled")
  maxRetries      Int         @default(3) @map("max_retries")
  
  // Statistics
  executionCount  Int         @default(0) @map("execution_count")
  successCount    Int         @default(0) @map("success_count")
  failureCount    Int         @default(0) @map("failure_count")
  
  lastExecuted    DateTime?   @map("last_executed")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  executions      WorkflowExecution[]
  
  @@index([trigger])
  @@index([isEnabled])
  @@map("workflows")
}

model WorkflowExecution {
  id              String      @id @default(uuid())
  workflowId      String      @map("workflow_id")
  
  // Execution context
  triggerData     Json        @map("trigger_data")
  executionId     String      @unique @map("execution_id") // UUID for tracking
  
  status          ExecutionStatus @default(RUNNING)
  
  // Progress tracking
  currentStep     Int         @default(0) @map("current_step")
  totalSteps      Int         @map("total_steps")
  
  // Results
  output          Json?
  errorMessage    String?     @map("error_message")
  
  // Timing
  startedAt       DateTime    @default(now()) @map("started_at")
  completedAt     DateTime?   @map("completed_at")
  duration        Int?        // milliseconds
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  workflow        Workflow    @relation(fields: [workflowId], references: [id])
  
  @@index([workflowId, status])
  @@index([startedAt])
  @@map("workflow_executions")
}

// ===== DATA BACKUP & ARCHIVAL =====

model BackupJob {
  id              String      @id @default(uuid())
  name            String
  description     String?
  
  // Backup configuration
  backupType      BackupType  @map("backup_type")
  tables          String[]    @default([]) // Empty means all tables
  frequency       BackupFrequency
  
  // Storage configuration
  storageProvider String      @map("storage_provider")
  storagePath     String      @map("storage_path")
  compression     Boolean     @default(true)
  encryption      Boolean     @default(true)
  
  // Retention policy
  retentionDays   Int         @map("retention_days")
  
  // Scheduling
  scheduleTime    String      @map("schedule_time") // Cron expression
  nextRun         DateTime?   @map("next_run")
  
  // Status
  isEnabled       Boolean     @default(true) @map("is_enabled")
  lastRun         DateTime?   @map("last_run")
  lastStatus      JobStatus?  @map("last_status")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  runs            BackupRun[]
  
  @@index([nextRun])
  @@index([isEnabled])
  @@map("backup_jobs")
}

model BackupRun {
  id              String      @id @default(uuid())
  jobId           String      @map("job_id")
  
  status          JobStatus   @default(PENDING)
  
  // File info
  fileName        String?     @map("file_name")
  fileSize        Int?        @map("file_size") // bytes
  filePath        String?     @map("file_path")
  
  // Progress
  tablesProcessed Int         @default(0) @map("tables_processed")
  totalTables     Int?        @map("total_tables")
  recordsBackedUp Int         @default(0) @map("records_backed_up")
  
  // Timing
  startedAt       DateTime    @map("started_at")
  completedAt     DateTime?   @map("completed_at")
  duration        Int?        // seconds
  
  // Error handling
  errorMessage    String?     @map("error_message")
  errorDetails    Json?       @map("error_details")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  job             BackupJob   @relation(fields: [jobId], references: [id])
  
  @@index([jobId, status])
  @@index([startedAt])
  @@map("backup_runs")
}

