    COUNT(DISTINCT o.user_id) as unique_customers
FROM orders o
JOIN shops s ON s.id = o.shop_id
WHERE o.status = 'DELIVERED'
GROUP BY DATE(o.created_at), s.id, s.name;

-- Product Performance Summary
CREATE MATERIALIZED VIEW product_performance_summary AS
SELECT 
    p.id,
    p.name,
    p.shop_id,
    COUNT(DISTINCT oi.order_id) as orders,
    SUM(oi.quantity) as units_sold,
    SUM(oi.total_amount) as revenue,
    AVG(pr.rating) as avg_rating,
    COUNT(pr.id) as review_count,
    pa.views as total_views,
    CASE 
        WHEN pa.views > 0 THEN (COUNT(DISTINCT oi.order_id)::float / pa.views) * 100 
        ELSE 0 
    END as conversion_rate
FROM products p
LEFT JOIN skus sk ON sk.spu_id = p.id
LEFT JOIN order_items oi ON oi.sku_id = sk.id
LEFT JOIN product_reviews pr ON pr.product_id = p.id
LEFT JOIN (
    SELECT product_id, SUM(views) as views 
    FROM product_analytics 
    GROUP BY product_id
) pa ON pa.product_id = p.id
WHERE p.is_active = true
GROUP BY p.id, p.name, p.shop_id, pa.views;

