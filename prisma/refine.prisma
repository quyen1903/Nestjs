// ===== ENHANCED DISCOUNT SYSTEM =====

model Discount {
  id              String      @id @default(uuid())
  shopId          String?     @map("shop_id") // Null for platform-wide discounts
  
  name            String
  description     String?
  code            String?     @unique // Null for automatic discounts
  
  type            DiscountType
  value           Decimal
  
  // Application rules
  appliesTo       DiscountAppliesTo @map("applies_to")
  minimumAmount   Decimal?    @map("minimum_amount")
  maximumDiscount Decimal?    @map("maximum_discount")
  
  // Target products/categories
  productIds      String[]    @default([]) @map("product_ids")
  categoryIds     Int[]       @default([]) @map("category_ids")
  
  // Usage limits
  usageLimit      Int?        @map("usage_limit")
  usageLimitPerCustomer Int? @map("usage_limit_per_customer")
  usageCount      Int         @default(0) @map("usage_count")
  
  // Customer eligibility
  eligibleCustomerIds String[] @default([]) @map("eligible_customer_ids")
  eligibleTiers    String[]    @default([]) @map("eligible_tiers")
  firstOrderOnly   Boolean     @default(false) @map("first_order_only")
  
  // Validity period
  startsAt        DateTime    @map("starts_at")
  endsAt          DateTime?   @map("ends_at")
  
  // Combination rules
  canCombine      Boolean     @default(false) @map("can_combine")
  priority        Int         @default(0) // Higher priority discounts apply first
  
  status          DiscountStatus @default(ACTIVE)
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  shop            Shop?       @relation(fields: [shopId], references: [id])
  usages          DiscountUsage[]
  
  @@index([shopId])
  @@index([code])
  @@index([status])
  @@index([startsAt, endsAt])
  @@map("discounts")
}

model DiscountUsage {
  id              String      @id @default(uuid())
  discountId      String      @map("discount_id")
  userId          String      @map("user_id")
  orderId         String      @map("order_id")
  
  discountAmount  Decimal     @map("discount_amount")
  
  usedAt          DateTime    @default(now()) @map("used_at")

  discount        Discount    @relation(fields: [discountId], references: [id])
  user            User        @relation(fields: [userId], references: [id])
  order           Order       @relation(fields: [orderId], references: [id])
  
  @@index([discountId])
  @@index([userId])
  @@map("discount_usages")
}

// ===== SECURITY & AUDIT SYSTEM =====

model LoginAttempt {
  id              String      @id @default(uuid())
  userId          String?     @map("user_id") // Null for failed attempts
  identifier      String      // Email, username, or phone
  ipAddress       String      @map("ip_address")
  userAgent       String      @map("user_agent")
  
  success         Boolean
  failureReason   String?     @map("failure_reason")
  
  // Geographic info
  country         String?
  region          String?
  city            String?
  
  attemptedAt     DateTime    @default(now()) @map("attempted_at")

  user            User?       @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([identifier])
  @@index([ipAddress])
  @@index([attemptedAt])
  @@map("login_attempts")
}

model AuditLog {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  action          String      // CREATE, UPDATE, DELETE, etc.
  resourceType    String      @map("resource_type") // User, Product, Order, etc.
  resourceId      String      @map("resource_id")
  
  // Change tracking
  oldValues       Json?       @map("old_values")
  newValues       Json?       @map("new_values")
  
  // Request context
  ipAddress       String      @map("ip_address")
  userAgent       String?     @map("user_agent")
  
  // Admin actions
  performedBy     String?     @map("performed_by") // Different from userId for admin actions
  reason          String?     // For administrative actions
  
  createdAt       DateTime    @default(now()) @map("created_at")

  user            User        @relation("UserAuditLogs", fields: [userId], references: [id])
  performer       User?       @relation("CreatedByUser", fields: [performedBy], references: [id])
  
  @@index([userId])
  @@index([resourceType, resourceId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model PasswordReset {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  token           String      @unique
  
  expiresAt       DateTime    @map("expires_at")
  usedAt          DateTime?   @map("used_at")
  
  // Security tracking
  ipAddress       String      @map("ip_address")
  userAgent       String?     @map("user_agent")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@index([token])
  @@index([expiresAt])
  @@map("password_resets")
}

// ===== SESSION MANAGEMENT =====

model UserKeyToken {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  
  publicKey       String      @map("public_key")
  refreshToken    String      @map("refresh_token")
  
  // Device info
  deviceId        String?     @map("device_id")
  deviceName      String?     @map("device_name")
  deviceType      String?     @map("device_type") // mobile, desktop, tablet
  
  // Security
  ipAddress       String      @map("ip_address")
  userAgent       String?     @map("user_agent")
  
  // Token lifecycle
  expiresAt       DateTime    @map("expires_at")
  lastUsedAt      DateTime    @default(now()) @map("last_used_at")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokensUsed UserRefreshTokenUsed[]
  
  @@index([userId])
  @@index([refreshToken])
  @@index([expiresAt])
  @@map("user_key_tokens")
}

model UserRefreshTokenUsed {
  id              String      @id @default(uuid())
  keyTokenId      String      @map("key_token_id")
  token           String      @map("refresh_token")
  
  usedAt          DateTime    @default(now()) @map("used_at")
  userAgent       String?     @map("user_agent")
  ipAddress       String?     @map("ip_address")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  keyToken        UserKeyToken @relation(fields: [keyTokenId], references: [id], onDelete: Cascade)
  
  @@index([token])
  @@index([keyTokenId])
  @@map("user_refresh_tokens_used")
}

// Shop session management (keeping original structure for compatibility)
model ShopKeyToken {
  id              String      @id @default(uuid())
  shopId          String      @unique @map("shop_id")
  publicKey       String      @map("public_key")
  refreshToken    String      @map("refresh_token")
  roles           RoleShop    @map("roles")

  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  refreshTokensUsed ShopRefreshTokenUsed[]
  shop            Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  
  @@map("shop_key_tokens")
}

model ShopRefreshTokenUsed {
  id              String      @id @default(uuid())
  keyTokenId      String      @map("key_token_id")
  token           String      @map("refresh_token")
  
  usedAt          DateTime    @default(now()) @map("used_at")
  userAgent       String?     @map("user_agent")
  ipAddress       String?     @map("ip_address")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  keyToken        ShopKeyToken @relation(fields: [keyTokenId], references: [id], onDelete: Cascade)
  
  @@index([token])
  @@map("shop_refresh_tokens_used")
}

// ===== API & INTEGRATION SYSTEM =====

model APIKey {
  id              String      @id @default(uuid())
  shopId          String      @map("shop_id")
  
  name            String      // Human-readable name
  keyHash         String      @unique @map("key_hash") // Hashed API key
  keyPreview      String      @map("key_preview") // Last 4 characters for display
  
  permissions     String[]    @default([])
  scopes          String[]    @default([]) // More granular than permissions
  
  // Usage limits
  rateLimit       Int?        @map("rate_limit") // Requests per minute
  monthlyLimit    Int?        @map("monthly_limit")
  
  // Usage tracking
  requestCount    Int         @default(0) @map("request_count")
  lastUsedAt      DateTime?   @map("last_used_at")
  
  // IP restrictions
  allowedIPs      String[]    @default([]) @map("allowed_ips")
  
  status          ApiKeyStatus @default(ACTIVE)
  
  // Lifecycle
  expiresAt       DateTime?   @map("expires_at")
  revokedAt       DateTime?   @map("revoked_at")
  revokedBy       String?     @map("revoked_by")
  revokeReason    String?     @map("revoke_reason")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  shop            Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  
  @@index([shopId])
  @@index([status])
  @@map("api_keys")
}

// ===== SHIPPING & LOGISTICS =====

model Shipment {
  id              String      @id @default(uuid())
  orderId         String      @map("order_id")
  shipmentNumber  String      @unique @map("shipment_number")
  
  // Carrier info
  carrier         String
  service         String      // Standard, Express, Overnight
  trackingNumber  String?     @map("tracking_number")
  
  // Addresses
  originAddress   Json        @map("origin_address")
  destinationAddress Json     @map("destination_address")
  
  // Package info
  weight          Decimal?
  dimensions      Json?
  packageCount    Int         @default(1) @map("package_count")
  
  // Costs
  shippingCost    Decimal     @map("shipping_cost")
  insuranceValue  Decimal?    @map("insurance_value")
  
  // Timeline
  estimatedDelivery DateTime? @map("estimated_delivery")
  shippedAt       DateTime?   @map("shipped_at")
  deliveredAt     DateTime?   @map("delivered_at")
  
  status          ShipmentStatus @default(CREATED)
  
  // Special instructions
  signatureRequired Boolean   @default(false) @map("signature_required")
  leaveAtDoor     Boolean     @default(false) @map("leave_at_door")
  instructions    String?
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  order           Order       @relation(fields: [orderId], references: [id])
  
  items           ShipmentItem[]
  trackingEvents  TrackingEvent[]
  
  @@index([orderId])
  @@index([trackingNumber])
  @@index([status])
  @@map("shipments")
}

model ShipmentItem {
  id              String      @id @default(uuid())
  shipmentId      String      @map("shipment_id")
  orderItemId     String      @map("order_item_id")
  
  quantity        Int
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  shipment        Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  orderItem       OrderItem   @relation(fields: [orderItemId], references: [id])
  
  @@unique([shipmentId, orderItemId])
  @@map("shipment_items")
}

model TrackingEvent {
  id              String      @id @default(uuid())
  shipmentId      String      @map("shipment_id")
  
  status          String
  description     String
  location        String?
  
  eventTime       DateTime    @map("event_time")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  shipment        Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  
  @@index([shipmentId])
  @@index([eventTime])
  @@map("tracking_events")
}

// ===== RETURNS & REFUNDS =====

model OrderReturn {
  id              String      @id @default(uuid())
  orderId         String      @map("order_id")
  returnNumber    String      @unique @map("return_number")
  
  returnType      ReturnType  @map("return_type")
  reason          ReturnReason
  description     String?
  
  // Return authorization
  status          ReturnStatus @default(REQUESTED)
  authorizedAt    DateTime?   @map("authorized_at")
  authorizedBy    String?     @map("authorized_by")
  
  // Processing
  receivedAt      DateTime?   @map("received_at")
  inspectedAt     DateTime?   @map("inspected_at")
  processedAt     DateTime?   @map("processed_at")
  
  // Refund info
  refundAmount    Decimal?    @map("refund_amount")
  refundMethod    String?     @map("refund_method")
  
  // Return shipping
  returnShippingCost Decimal? @map("return_shipping_cost")
  returnTrackingNumber String? @map("return_tracking_number")
  
  // Quality control
  condition       ItemCondition? 
  qualityNotes    String?     @map("quality_notes")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  order           Order       @relation(fields: [orderId], references: [id])
  
  items           ReturnItem[]
  refunds         Refund[]
  
  @@index([orderId])
  @@index([status])
  @@map("order_returns")
}

model ReturnItem {
  id              String      @id @default(uuid())
  returnId        String      @map("return_id")
  orderItemId     String      @map("order_item_id")
  
  quantity        Int
  returnReason    ReturnReason @map("return_reason")
  condition       ItemCondition?
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  return          OrderReturn @relation(fields: [returnId], references: [id], onDelete: Cascade)
  orderItem       OrderItem   @relation(fields: [orderItemId], references: [id])
  
  @@unique([returnId, orderItemId])
  @@map("return_items")
}

model Refund {
  id              String      @id @default(uuid())
  orderId         String?     @map("order_id")
  returnId        String?     @map("return_id")
  transactionId   String?     @map("transaction_id")
  
  refundNumber    String      @unique @map("refund_number")
  amount          Decimal
  currency        String      @default("USD")
  
  reason          String?
  status          RefundStatus @default(PENDING)
  
  // Payment provider info
  provider        String?
  providerRefundId String?    @map("provider_refund_id")
  
  // Timeline
  requestedAt     DateTime    @default(now()) @map("requested_at")
  processedAt     DateTime?   @map("processed_at")
  completedAt     DateTime?   @map("completed_at")
  failedAt        DateTime?   @map("failed_at")
  
  // Failure info
  failureReason   String?     @map("failure_reason")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  order           Order?      @relation(fields: [orderId], references: [id])
  return          OrderReturn? @relation(fields: [returnId], references: [id])
  transaction     PaymentTransaction? @relation(fields: [transactionId], references: [id])
  
  @@index([orderId])
  @@index([status])
  @@map("refunds")
}

// ===== INVOICING & BILLING =====

model Invoice {
  id              String      @id @default(uuid())
  orderId         String      @map("order_id")
  invoiceNumber   String      @unique @map("invoice_number")
  
  // Amounts
  subtotal        Decimal
  taxAmount       Decimal     @map("tax_amount")
  discountAmount  Decimal     @default(0) @map("discount_amount")
  shippingAmount  Decimal     @default(0) @map("shipping_amount")
  totalAmount     Decimal     @map("total_amount")
  
  currency        String      @default("USD")
  
  // Dates
  issuedAt        DateTime    @map("issued_at")
  dueAt           DateTime?   @map("due_at")
  paidAt          DateTime?   @map("paid_at")
  
  status          InvoiceStatus @default(DRAFT)
  
  // Billing info
  billingAddress  Json        @map("billing_address")
  
  // File storage
  pdfUrl          String?     @map("pdf_url")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  order           Order       @relation(fields: [orderId], references: [id])
  
  @@index([orderId])
  @@index([invoiceNumber])
  @@map("invoices")
}

// ===== WISHLIST & FAVORITES =====

model Wishlist {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  name            String      @default("My Wishlist")
  description     String?
  
  isDefault       Boolean     @default(false) @map("is_default")
  isPublic        Boolean     @default(false) @map("is_public")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  items           WishlistItem[]
  
  @@index([userId])
  @@map("wishlists")
}

model WishlistItem {
  id              String      @id @default(uuid())
  wishlistId      String      @map("wishlist_id")
  productId       String      @map("product_id")
  
  notes           String?
  priority        Int         @default(0)
  
  addedAt         DateTime    @default(now()) @map("added_at")
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  wishlist        Wishlist    @relation(fields: [wishlistId], references: [id], onDelete: Cascade)
  product         Spu         @relation(fields: [productId], references: [id])
  
  @@unique([wishlistId, productId])
  @@map("wishlist_items")
}

// ===== PRODUCT BUNDLES & CROSS-SELLS =====

model ProductBundle {
  id              String      @id @default(uuid())
  mainProductId   String      @map("main_product_id")
  bundledProductId String     @map("bundled_product_id")
  
  bundleType      BundleType  @map("bundle_type")
  discountAmount  Decimal?    @map("discount_amount")
  discountPercent Decimal?    @map("discount_percent")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  mainProduct     Spu         @relation("BundleProducts", fields: [mainProductId], references: [id])
  bundledProduct  Spu         @relation("BundleItems", fields: [bundledProductId], references: [id])
  
  @@unique([mainProductId, bundledProductId])
  @@map("product_bundles")
}

model CrossSell {
  id              String      @id @default(uuid())
  fromProductId   String      @map("from_product_id")
  toProductId     String      @map("to_product_id")
  
  type            CrossSellType // RELATED, COMPLEMENTARY, ALTERNATIVE, UPSELL
  priority        Int         @default(0)
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  fromProduct     Spu         @relation("CrossSellFrom", fields: [fromProductId], references: [id])
  toProduct       Spu         @relation("CrossSellTo", fields: [toProductId], references: [id])
  
  @@unique([fromProductId, toProductId])
  @@map("cross_sells")
}

// ===== PRICING & PROMOTIONS =====

model PriceHistory {
  id              String      @id @default(uuid())
  skuId           String      @map("sku_id")
  
  priceType       PriceType   @map("price_type")
  oldPrice        Decimal     @map("old_price")
  newPrice        Decimal     @map("new_price")
  
  reason          String?     // Sale, competitor pricing, cost change, etc.
  changedBy       String      @map("changed_by")
  effectiveFrom   DateTime    @map("effective_from")
  effectiveUntil  DateTime?   @map("effective_until")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  sku             Sku         @relation(fields: [skuId], references: [id])
  changer         User        @relation(fields: [changedBy], references: [id])
  
  @@index([skuId])
  @@index([effectiveFrom])
  @@map("price_history")
}

// ===== NOTIFICATIONS & MESSAGING =====

model NotificationThread {
  id              String      @id @default(uuid())
  userId          String      @unique @map("user_id")
  
  unreadCount     Int         @default(0) @map("unread_count")
  lastReadAt      DateTime?   @map("last_read_at")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user            User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  notifications   Notification[]
  
  @@map("notification_threads")
}

model Notification {
  id              String      @id @default(uuid())
  threadId        String      @map("thread_id")
  
  type            NotificationType
  title           String
  content         String
  
  // Rich content
  data            Json?       // Additional structured data
  actionUrl       String?     @map("action_url")
  imageUrl        String?     @map("image_url")
  
  // Targeting
  senderId        String?     @map("sender_id") // Shop or system
  
  // Delivery
  channels        NotificationChannel[] @map("channels") // EMAIL, PUSH, SMS, IN_APP
  status          NotificationStatus @default(PENDING)
  
  // Interaction tracking
  readAt          DateTime?   @map("read_at")
  clickedAt       DateTime?   @map("clicked_at")
  
  // Scheduling
  scheduledFor    DateTime?   @map("scheduled_for")
  
  // Template info
  templateId      String?     @map("template_id")
  templateData    Json?       @map("template_data")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  thread          NotificationThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender          Shop?       @relation(fields: [senderId], references: [id])
  
  @@index([threadId])
  @@index([type])
  @@index([status])
  @@index([scheduledFor])
  @@map("notifications")
}

model Message {
  id              String      @id @default(uuid())
  
  // Participants
  senderId        String      @map("sender_id")
  recipientId     String      @map("recipient_id")
  senderType      MessageParticipantType @map("sender_type")
  recipientType   MessageParticipantType @map("recipient_type")
  
  // Content
  content         String      @db.Text
  messageType     MessageContentType @map("message_type")
  
  // Attachments
  attachments     Json?       // URLs and metadata for files, images
  
  // Threading
  threadId        String?     @map("thread_id") // For grouping related messages
  replyToId       String?     @map("reply_to_id")
  
  // Status
  status          MessageStatus @default(SENT)
  readAt          DateTime?   @map("read_at")
  deliveredAt     DateTime?   @map("delivered_at")
  
  // Metadata
  priority        MessagePriority @default(NORMAL)
  tags            String[]    @default([])
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  // Relations based on participant types
  senderUser      User?       @relation("UserMessages", fields: [senderId], references: [id])
  recipientShop   Shop?       @relation("ShopMessages", fields: [recipientId], references: [id])
  replyTo         Message?    @relation("MessageReplies", fields: [replyToId], references: [id])
  replies         Message[]   @relation("MessageReplies")
  
  @@index([senderId, senderType])
  @@index([recipientId, recipientType])
  @@index([threadId])
  @@index([status])
  @@map("messages")
}

// ===== ANALYTICS & REPORTING =====

model ShopAnalytics {
  id              String      @id @default(uuid())
  shopId          String      @map("shop_id")
  
  date            DateTime    @db.Date
  
  // Sales metrics
  totalSales      Decimal     @default(0) @map("total_sales")
  totalOrders     Int         @default(0) @map("total_orders")
  averageOrderValue Decimal   @default(0) @map("average_order_value")
  
  // Product metrics
  productViews    Int         @default(0) @map("product_views")
  addToCarts      Int         @default(0) @map("add_to_carts")
  conversions     Int         @default(0)
  conversionRate  Decimal     @default(0) @map("conversion_rate")
  
  // Customer metrics
  newCustomers    Int         @default(0) @map("new_customers")
  returningCustomers Int      @default(0) @map("returning_customers")
  
  // Inventory metrics
  lowStockItems   Int         @default(0) @map("low_stock_items")
  outOfStockItems Int         @default(0) @map("out_of_stock_items")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  shop            Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  
  @@unique([shopId, date])
  @@index([date])
  @@map("shop_analytics")
}

// ===== FINANCIAL MANAGEMENT =====

model ShopPayout {
  id              String      @id @default(uuid())
  shopId          String      @map("shop_id")
  
  payoutNumber    String      @unique @map("payout_number")
  amount          Decimal
  currency        String      @default("USD")
  
  // Period covered
  periodStart     DateTime    @map("period_start")
  periodEnd       DateTime    @map("period_end")
  
  // Fees and deductions
  platformFee     Decimal     @default(0) @map("platform_fee")
  processingFee   Decimal     @default(0) @map("processing_fee")
  adjustments     Decimal     @default(0)
  netAmount       Decimal     @map("net_amount")
  
  status          PayoutStatus @default(PENDING)
  
  // Payment details
  paymentMethod   String?     @map("payment_method")
  bankAccount     Json?       @map("bank_account")
  
  // Timeline
  scheduledFor    DateTime?   @map("scheduled_for")
  processedAt     DateTime?   @map("processed_at")
  paidAt          DateTime?   @map("paid_at")
  failedAt        DateTime?   @map("failed_at")
  
  failureReason   String?     @map("failure_reason")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  shop            Shop        @relation(fields: [shopId], references: [id])
  
  @@index([shopId])
  @@index([status])
  @@map("shop_payouts")
}

// ===== SUBSCRIPTION MANAGEMENT =====

model ShopSubscription {
  id              String      @id @default(uuid())
  shopId          String      @map("shop_id")
  
  planName        String      @map("plan_name")
  planType        SubscriptionType @map("plan_type")
  
  // Billing
  amount          Decimal
  currency        String      @default("USD")
  billingInterval SubscriptionInterval @map("billing_interval")
  
  // Period
  currentPeriodStart DateTime @map("current_period_start")
  currentPeriodEnd   DateTime @map("current_period_end")
  
  // Status
  status          SubscriptionStatus @default(ACTIVE)
  
  // Trial
  trialStart      DateTime?   @map("trial_start")
  trialEnd        DateTime?   @map("trial_end")
  
  // Cancellation
  cancelAt        DateTime?   @map("cancel_at")
  cancelledAt     DateTime?   @map("cancelled_at")
  cancelReason    String?     @map("cancel_reason")
  
  // Provider info
  providerSubscriptionId String? @map("provider_subscription_id")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")


  shop            Shop        @relation(fields: [shopId], references: [id], onDelete: Cascade)
  
  @@index([shopId])
  @@index([status])
  @@map("shop_subscriptions")
}

// ===== ADVANCED MARKETING & CAMPAIGNS =====

model Campaign {
  id              String      @id @default(uuid())
  shopId          String?     @map("shop_id") // Null for platform campaigns
  
  name            String
  description     String?
  type            CampaignType
  
  // Campaign settings
  budget          Decimal?
  budgetType      BudgetType? @map("budget_type") // DAILY, WEEKLY, MONTHLY, TOTAL
  
  // Targeting
  targetAudience  Json?       @map("target_audience")
  geoTargeting    Json?       @map("geo_targeting")
  
  // Content
  content         Json        // Email templates, push content, etc.
  
  // Scheduling
  startsAt        DateTime    @map("starts_at")
  endsAt          DateTime?   @map("ends_at")
  
  // Performance tracking
  impressions     Int         @default(0)
  clicks          Int         @default(0)
  conversions     Int         @default(0)
  spend           Decimal     @default(0)
  revenue         Decimal     @default(0)
  
  status          CampaignStatus @default(DRAFT)
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  shop            Shop?       @relation(fields: [shopId], references: [id])
  audiences       CampaignAudience[]
  
  @@index([shopId])
  @@index([type])
  @@index([status])
  @@map("campaigns")
}

model CampaignAudience {
  id              String      @id @default(uuid())
  campaignId      String      @map("campaign_id")
  
  name            String
  description     String?
  
  // Audience criteria
  criteria        Json        // Age, location, purchase history, etc.
  estimatedSize   Int?        @map("estimated_size")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  campaign        Campaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  
  @@index([campaignId])
  @@map("campaign_audiences")
}

// ===== CUSTOMER SUPPORT SYSTEM =====

model SupportTicket {
  id              String      @id @default(uuid())
  ticketNumber    String      @unique @map("ticket_number")
  
  userId          String      @map("user_id")
  shopId          String?     @map("shop_id")
  orderId         String?     @map("order_id")
  
  // Ticket details
  subject         String
  description     String      @db.Text
  category        SupportCategory
  priority        SupportPriority @default(NORMAL)
  
  // Status tracking
  status          TicketStatus @default(OPEN)
  assignedTo      String?     @map("assigned_to")
  
  // Resolution
  resolution      String?     @db.Text
  resolvedAt      DateTime?   @map("resolved_at")
  closedAt        DateTime?   @map("closed_at")
  
  // Customer satisfaction
  satisfactionRating Int?     @map("satisfaction_rating") // 1-5
  feedback        String?
  
  // SLA tracking
  firstResponseAt DateTime?   @map("first_response_at")
  responseTime    Int?        @map("response_time") // Minutes
  resolutionTime  Int?        @map("resolution_time") // Minutes
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user            User        @relation(fields: [userId], references: [id])
  shop            Shop?       @relation(fields: [shopId], references: [id])
  order           Order?      @relation(fields: [orderId], references: [id])
  assignee        User?       @relation("AssignedTickets", fields: [assignedTo], references: [id])
  
  responses       TicketResponse[]
  attachments     TicketAttachment[]
  
  @@index([userId])
  @@index([status])
  @@index([assignedTo])
  @@index([createdAt])
  @@map("support_tickets")
}

model TicketResponse {
  id              String      @id @default(uuid())
  ticketId        String      @map("ticket_id")
  
  userId          String      @map("user_id")
  userType        ResponseUserType @map("user_type") // CUSTOMER, SUPPORT, SYSTEM
  
  content         String      @db.Text
  isInternal      Boolean     @default(false) @map("is_internal") // Internal notes
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  ticket          SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  user            User        @relation(fields: [userId], references: [id])
  
  @@index([ticketId])
  @@map("ticket_responses")
}

model TicketAttachment {
  id              String      @id @default(uuid())
  ticketId        String      @map("ticket_id")
  
  filename        String
  originalName    String      @map("original_name")
  mimeType        String      @map("mime_type")
  fileSize        Int         @map("file_size")
  fileUrl         String      @map("file_url")
  
  uploadedBy      String      @map("uploaded_by")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  ticket          SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  uploader        User        @relation(fields: [uploadedBy], references: [id])
  
  @@index([ticketId])
  @@map("ticket_attachments")
}

// ===== CONTENT MANAGEMENT & SEO =====

model Page {
  id              String      @id @default(uuid())
  shopId          String?     @map("shop_id") // Null for platform pages
  
  title           String
  slug            String
  content         String      @db.Text
  excerpt         String?
  
  // Page type and template
  pageType        PageType    @map("page_type")
  template        String?     // Template identifier
  
  // SEO
  metaTitle       String?     @map("meta_title")
  metaDescription String?     @map("meta_description")
  metaKeywords    String?     @map("meta_keywords")
  
  // Media
  featuredImage   String?     @map("featured_image")
  
  // Publishing
  status          PageStatus  @default(DRAFT)
  publishedAt     DateTime?   @map("published_at")
  
  // Author and editor
  authorId        String      @map("author_id")
  lastEditedBy    String?     @map("last_edited_by")
  
  // Ordering and hierarchy
  parentId        String?     @map("parent_id")
  sortOrder       Int         @default(0) @map("sort_order")
  
  // Analytics
  viewCount       Int         @default(0) @map("view_count")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  shop            Shop?       @relation(fields: [shopId], references: [id])
  author          User        @relation("AuthoredPages", fields: [authorId], references: [id])
  editor          User?       @relation("EditedPages", fields: [lastEditedBy], references: [id])
  parent          Page?       @relation("PageHierarchy", fields: [parentId], references: [id])
  children        Page[]      @relation("PageHierarchy")
  
  @@unique([shopId, slug])
  @@index([pageType])
  @@index([status])
  @@map("pages")
}

model BlogPost {
  id              String      @id @default(uuid())
  shopId          String?     @map("shop_id")
  
  title           String
  slug            String
  content         String      @db.Text
  excerpt         String?
  
  // Media
  featuredImage   String?     @map("featured_image")
  
  // Categorization
  categories      String[]    @default([])
  tags            String[]    @default([])
  
  // SEO
  metaTitle       String?     @map("meta_title")
  metaDescription String?     @map("meta_description")
  
  // Publishing
  status          PageStatus  @default(DRAFT)
  publishedAt     DateTime?   @map("published_at")
  
  // Author
  authorId        String      @map("author_id")
  
  // Engagement
  viewCount       Int         @default(0) @map("view_count")
  likeCount       Int         @default(0) @map("like_count")
  shareCount      Int         @default(0) @map("share_count")
  
  // Comments
  allowComments   Boolean     @default(true) @map("allow_comments")
  commentCount    Int         @default(0) @map("comment_count")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  shop            Shop?       @relation(fields: [shopId], references: [id])
  author          User        @relation(fields: [authorId], references: [id])
  
  @@unique([shopId, slug])
  @@index([status])
  @@index([publishedAt])
  @@map("blog_posts")
}

// ===== SOCIAL FEATURES =====

model UserFollow {
  id              String      @id @default(uuid())
  followerId      String      @map("follower_id")
  followingId     String      @map("following_id")
  followingType   FollowType  @map("following_type") // USER, SHOP, BRAND
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  follower        User        @relation("UserFollowing", fields: [followerId], references: [id])
  following       User?       @relation("UserFollowers", fields: [followingId], references: [id])
  shop            Shop?       @relation("ShopFollowers", fields: [followingId], references: [id])
  
  @@unique([followerId, followingId, followingType])
  @@index([followerId])
  @@index([followingId, followingType])
  @@map("user_follows")
}

model SocialShare {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  
  resourceType    String      @map("resource_type") // product, shop, blog_post
  resourceId      String      @map("resource_id")
  
  platform        SocialPlatform
  shareUrl        String?     @map("share_url")
  content         String?     // Custom message
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user            User        @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([resourceType, resourceId])
  @@map("social_shares")
}

// ===== REPORTING & ANALYTICS =====

model UserActivity {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  sessionId       String?     @map("session_id")
  
  activityType    ActivityType @map("activity_type")
  resourceType    String?     @map("resource_type")
  resourceId      String?     @map("resource_id")
  
  // Context
  page            String?     // URL or page identifier
  referrer        String?
  userAgent       String?     @map("user_agent")
  ipAddress       String?     @map("ip_address")
  
  // Geographic
  country         String?
  region          String?
  city            String?
  
  // Additional data
  metadata        Json?
  
  duration        Int?        // Time spent (seconds)
  
  createdAt       DateTime    @default(now()) @map("created_at")

  user            User        @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([activityType])
  @@index([createdAt])
  @@index([resourceType, resourceId])
  @@map("user_activities")
}

model ProductAnalytics {
  id              String      @id @default(uuid())
  productId       String      @map("product_id")
  
  date            DateTime    @db.Date
  
  // View metrics
  views           Int         @default(0)
  uniqueViews     Int         @default(0) @map("unique_views")
  
  // Engagement metrics
  addToCarts      Int         @default(0) @map("add_to_carts")
  wishlisted      Int         @default(0)
  shared          Int         @default(0)
  
  // Sales metrics
  orders          Int         @default(0)
  revenue         Decimal     @default(0)
  
  // Search metrics
  searchImpressions Int       @default(0) @map("search_impressions")
  searchClicks    Int         @default(0) @map("search_clicks")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  product         Spu         @relation(fields: [productId], references: [id])
  
  @@unique([productId, date])
  @@index([date])
  @@map("product_analytics")
}

// ===== SYSTEM CONFIGURATION =====

model SystemConfig {
  id              String      @id @default(uuid())
  key             String      @unique
  value           String      @db.Text
  dataType        ConfigDataType @map("data_type") // STRING, NUMBER, BOOLEAN, JSON
  
  category        String?     // Group related configs
  description     String?
  
  // Validation
  isRequired      Boolean     @default(false) @map("is_required")
  validationRules Json?       @map("validation_rules")
  
  // Environment specific
  environment     String?     // production, staging, development
  
  lastUpdatedBy   String      @map("last_updated_by")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  updater         User        @relation(fields: [lastUpdatedBy], references: [id])
  
  @@index([category])
  @@index([environment])
  @@map("system_configs")
}

model TaxRule {
  id              String      @id @default(uuid())
  name            String
  description     String?
  
  // Geographic scope
  countryCode     String      @map("country_code")
  stateCode       String?     @map("state_code")
  city            String?
  postalCode      String?     @map("postal_code")
  
  // Tax details
  taxRate         Decimal     @map("tax_rate")
  taxType         TaxType     @map("tax_type") // SALES, VAT, GST, etc.
  
  // Product applicability
  categoryIds     Int[]       @default([]) @map("category_ids")
  productIds      String[]    @default([]) @map("product_ids")
  
  // Validity
  effectiveFrom   DateTime    @map("effective_from")
  effectiveUntil  DateTime?   @map("effective_until")
  
  priority        Int         @default(0) // For conflicting rules
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  
  @@index([countryCode])
  @@index([effectiveFrom])
  @@map("tax_rules")
}

model ShippingZone {
  id              String      @id @default(uuid())
  name            String
  description     String?
  
  // Geographic coverage
  countries       String[]    @default([])
  states          String[]    @default([])
  postalCodes     String[]    @default([]) @map("postal_codes")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  methods         ShippingMethod[]
  
  @@map("shipping_zones")
}

model ShippingMethod {
  id              String      @id @default(uuid())
  zoneId          String      @map("zone_id")
  shopId          String?     @map("shop_id") // Null for platform methods
  
  name            String
  description     String?
  carrier         String?     // UPS, FedEx, DHL, etc.
  service         String?     // Standard, Express, Overnight
  
  // Pricing
  baseCost        Decimal     @map("base_cost")
  costPerWeight   Decimal?    @map("cost_per_weight")
  costPerDistance Decimal?    @map("cost_per_distance")
  freeShippingThreshold Decimal? @map("free_shipping_threshold")
  
  // Delivery time
  minDays         Int?        @map("min_days")
  maxDays         Int?        @map("max_days")
  
  // Constraints
  minWeight       Decimal?    @map("min_weight")
  maxWeight       Decimal?    @map("max_weight")
  minValue        Decimal?    @map("min_value")
  maxValue        Decimal?    @map("max_value")
  
  // Features
  trackingAvailable Boolean   @default(false) @map("tracking_available")
  signatureRequired Boolean   @default(false) @map("signature_required")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  zone            ShippingZone @relation(fields: [zoneId], references: [id])
  shop            Shop?       @relation(fields: [shopId], references: [id])
  
  @@index([zoneId])
  @@index([shopId])
  @@map("shipping_methods")
}

// ===== FILE MANAGEMENT =====

model MediaFile {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  
  filename        String
  originalName    String      @map("original_name")
  mimeType        String      @map("mime_type")
  fileSize        Int         @map("file_size")
  
  // Storage info
  storageProvider String      @map("storage_provider") // aws_s3, cloudinary, local
  storagePath     String      @map("storage_path")
  publicUrl       String      @map("public_url")
  
  // Image specific
  width           Int?
  height          Int?
  altText         String?     @map("alt_text")
  
  // Variants (thumbnails, etc.)
  variants        Json?       // Different sizes/formats
  
  // Metadata
  metadata        Json?       // EXIF, etc.
  tags            String[]    @default([])
  
  // Usage tracking
  usageCount      Int         @default(0) @map("usage_count")
  lastUsedAt      DateTime?   @map("last_used_at")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  uploader        User        @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@index([mimeType])
  @@index([createdAt])
  @@map("media_files")
}

// ===== WEBHOOKS & INTEGRATIONS =====

model Webhook {
  id              String      @id @default(uuid())
  shopId          String?     @map("shop_id")
  
  name            String
  url             String
  events          String[]    @default([]) // order.created, product.updated, etc.
  
  // Security
  secret          String?     // For signature verification
  
  // Headers and authentication
  headers         Json?       // Custom headers
  authType        WebhookAuthType? @map("auth_type")
  authCredentials Json?       @map("auth_credentials")
  
  // Retry configuration
  maxRetries      Int         @default(3) @map("max_retries")
  retryDelay      Int         @default(1000) @map("retry_delay") // milliseconds
  
  // Status
  status          WebhookStatus @default(ACTIVE)
  lastTriggered   DateTime?   @map("last_triggered")
  
  // Stats
  successCount    Int         @default(0) @map("success_count")
  failureCount    Int         @default(0) @map("failure_count")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  shop            Shop?       @relation(fields: [shopId], references: [id])
  deliveries      WebhookDelivery[]
  
  @@index([shopId])
  @@index([status])
  @@map("webhooks")
}

model WebhookDelivery {
  id              String      @id @default(uuid())
  webhookId       String      @map("webhook_id")
  
  event           String
  payload         Json
  
  // Delivery attempt
  httpStatus      Int?        @map("http_status")
  responseBody    String?     @map("response_body")
  responseHeaders Json?       @map("response_headers")
  
  // Timing
  duration        Int?        // milliseconds
  attemptedAt     DateTime    @map("attempted_at")
  deliveredAt     DateTime?   @map("delivered_at")
  
  // Retry info
  retryCount      Int         @default(0) @map("retry_count")
  nextRetryAt     DateTime?   @map("next_retry_at")
  
  status          DeliveryStatus @default(PENDING)
  errorMessage    String?     @map("error_message")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  webhook         Webhook     @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  
  @@index([webhookId])
  @@index([status])
  @@index([nextRetryAt])
  @@map("webhook_deliveries")
}

