// ===== ADVANCED DATABASE PATTERNS & IMPLEMENTATIONS =====

// ===== TEMPORAL DATA MANAGEMENT =====

model ProductSnapshot {
  id              String      @id @default(uuid())
  productId       String      @map("product_id")
  
  // Snapshot data (JSON copy of product at point in time)
  productData     Json        @map("product_data")
  priceData       Json        @map("price_data")
  inventoryData   Json        @map("inventory_data")
  
  // Temporal tracking
  validFrom       DateTime    @map("valid_from")
  validTo         DateTime?   @map("valid_to")
  
  // Change tracking
  changeType      ChangeType  @map("change_type")
  changedBy       String      @map("changed_by")
  changeReason    String?     @map("change_reason")
  
  // Version control
  version         Int         @default(1)
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")

  product         Spu         @relation(fields: [productId], references: [id])
  changer         User        @relation(fields: [changedBy], references: [id])
  
  @@index([productId, validFrom])
  @@index([validTo])
  @@map("product_snapshots")
}

model UserSnapshot {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  
  // User data at point in time
  userData        Json        @map("user_data")
  profileData     Json        @map("profile_data")
  preferencesData Json        @map("preferences_data")
  
  validFrom       DateTime    @map("valid_from")
  validTo         DateTime?   @map("valid_to")
  
  changeType      ChangeType  @map("change_type")
  changedBy       String      @map("changed_by")
  
  version         Int         @default(1)
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")

  user            User        @relation(fields: [userId], references: [id])
  changer         User        @relation("UserSnapshotChanger", fields: [changedBy], references: [id])
  
  @@index([userId, validFrom])
  @@map("user_snapshots")
}

// ===== ADVANCED AUDIT SYSTEM =====

model DetailedAuditLog {
  id              String      @id @default(uuid())
  
  // Context information
  userId          String?     @map("user_id")
  sessionId       String?     @map("session_id")
  requestId       String?     @map("request_id")
  
  // Action details
  entity          String      // Table/model name
  entityId        String      @map("entity_id")
  action          AuditAction
  
  // Change tracking
  oldValues       Json?       @map("old_values")
  newValues       Json?       @map("new_values")
  changedFields   String[]    @default([]) @map("changed_fields")
  
  // Request context
  endpoint        String?     // API endpoint
  method          String?     // HTTP method
  userAgent       String?     @map("user_agent")
  ipAddress       String      @map("ip_address")
  
  // Geographic context
  country         String?
  region          String?
  city            String?
  
  // Risk assessment
  riskScore       Int?        @map("risk_score")
  riskFactors     String[]    @default([]) @map("risk_factors")
  
  // Business context
  businessReason  String?     @map("business_reason")
  approvedBy      String?     @map("approved_by")
  
  // Compliance tracking
  complianceFlags String[]    @default([]) @map("compliance_flags")
  retentionDate   DateTime?   @map("retention_date")
  
  timestamp       DateTime    @default(now())
  
  user            User?       @relation("DetailedAuditUser", fields: [userId], references: [id])
  approver        User?       @relation("DetailedAuditApprover", fields: [approvedBy], references: [id])
  
  @@index([userId, timestamp])
  @@index([entity, entityId])
  @@index([action, timestamp])
  @@index([ipAddress])
  @@index([retentionDate])
  @@map("detailed_audit_logs")
}

// ===== NOTIFICATION SYSTEM ENHANCEMENT =====

model NotificationTemplate {
    id              String      @id @default(uuid())
    name            String      @unique
    description     String?

    // Template content for different channels
    emailSubject    String?     @map("email_subject")
    emailBody       String?     @map("email_body") @db.Text
    emailBodyHtml   String?     @map("email_body_html") @db.Text

    smsContent      String?     @map("sms_content")
    pushTitle       String?     @map("push_title")
    pushBody        String?     @map("push_body")

    inAppTitle      String?     @map("in_app_title")
    inAppContent    String?     @map("in_app_content") @db.Text

    // Template variables
    variables       Json?       // Available template variables

    // Localization support
    defaultLocale   String      @default("en") @map("default_locale")

    // A/B testing
    variants        Json?       // Different template variants

    // Analytics
    usageCount      Int         @default(0) @map("usage_count")

    // Categories and tags
    category        NotificationCategory
    tags            String[]    @default([])

    // Permissions
    allowedShops    String[]    @default([]) @map("allowed_shops")

    isActive        Boolean     @default(true) @map("is_active")
    createdAt       DateTime    @default(now()) @map("created_at")
    updatedAt       DateTime    @updatedAt @map("updated_at")

    localizations   NotificationLocalization[]
    queueItems      NotificationQueue[]


    @@index([category])
    @@index([name])
    @@map("notification_templates")
}

model NotificationLocalization {
  id              String      @id @default(uuid())
  templateId      String      @map("template_id")
  locale          String
  
  emailSubject    String?     @map("email_subject")
  emailBody       String?     @map("email_body") @db.Text
  emailBodyHtml   String?     @map("email_body_html") @db.Text
  
  smsContent      String?     @map("sms_content")
  pushTitle       String?     @map("push_title")
  pushBody        String?     @map("push_body")
  
  inAppTitle      String?     @map("in_app_title")
  inAppContent    String?     @map("in_app_content") @db.Text
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  template        NotificationTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  
  @@unique([templateId, locale])
  @@map("notification_localizations")
}

model NotificationQueue {
  id              String      @id @default(uuid())
  templateId      String      @map("template_id")
  userId          String      @map("user_id")
  
  // Recipient info
  channels        NotificationChannel[] @map("channels")
  priority        NotificationPriority @default(NORMAL)
  
  // Template data
  templateData    Json?       @map("template_data")
  locale          String      @default("en")
  
  // Scheduling
  scheduledFor    DateTime?   @map("scheduled_for")
  
  // Delivery tracking
  status          QueueStatus @default(PENDING)
  attempts        Int         @default(0)
  maxAttempts     Int         @default(3) @map("max_attempts")
  
  // Results
  deliveryResults Json?       @map("delivery_results")
  errorMessage    String?     @map("error_message")
  
  // Timing
  processedAt     DateTime?   @map("processed_at")
  deliveredAt     DateTime?   @map("delivered_at")
  nextRetryAt     DateTime?   @map("next_retry_at")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  template        NotificationTemplate @relation(fields: [templateId], references: [id])
  user            User        @relation(fields: [userId], references: [id])
  
  @@index([status, scheduledFor])
  @@index([nextRetryAt])
  @@index([userId])
  @@map("notification_queue")
}

// ===== ADVANCED SEARCH & FILTERING =====

model SearchFilter {
  id              String      @id @default(uuid())
  name            String
  displayName     String      @map("display_name")
  description     String?
  
  filterType      FilterType  @map("filter_type")
  dataType        FilterDataType @map("data_type")
  
  // Configuration
  config          Json        // Filter-specific configuration
  
  // Database mapping
  tableColumn     String      @map("table_column")
  joinTables      Json?       @map("join_tables") // Required joins
  
  // UI configuration
  uiComponent     String      @map("ui_component") // dropdown, slider, checkbox
  uiConfig        Json?       @map("ui_config")
  
  // Categories this filter applies to
  categoryIds     Int[]       @default([]) @map("category_ids")
  
  // Display settings
  sortOrder       Int         @default(0) @map("sort_order")
  showCount       Boolean     @default(true) @map("show_count") // Show result counts
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  options         SearchFilterOption[]
  
  @@index([filterType])
  @@index([sortOrder])
  @@map("search_filters")
}

model SearchFilterOption {
  id              String      @id @default(uuid())
  filterId        String      @map("filter_id")
  
  value           String      // The actual filter value
  displayName     String      @map("display_name")
  description     String?
  
  // Hierarchy support for nested options
  parentId        String?     @map("parent_id")
  level           Int         @default(0)
  
  // Usage statistics
  usageCount      Int         @default(0) @map("usage_count")
  
  sortOrder       Int         @default(0) @map("sort_order")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  filter          SearchFilter @relation(fields: [filterId], references: [id], onDelete: Cascade)
  parent          SearchFilterOption? @relation("FilterOptionHierarchy", fields: [parentId], references: [id])
  children        SearchFilterOption[] @relation("FilterOptionHierarchy")
  
  @@index([filterId, sortOrder])
  @@map("search_filter_options")
}

model SavedSearch {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  
  name            String
  query           String?
  filters         Json        // Applied filters
  sortBy          String?     @map("sort_by")
  
  // Notification settings
  alertEnabled    Boolean     @default(false) @map("alert_enabled")
  alertFrequency  AlertFrequency? @map("alert_frequency")
  lastAlertSent   DateTime?   @map("last_alert_sent")
  
  // Usage tracking
  accessCount     Int         @default(0) @map("access_count")
  lastAccessed    DateTime?   @map("last_accessed")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  user            User        @relation(fields: [userId], references: [id])
  
  @@index([userId])
  @@map("saved_searches")
}

// ===== PERFORMANCE MONITORING =====

model QueryPerformance {
  id              String      @id @default(uuid())
  
  // Query identification
  queryHash       String      @map("query_hash") // MD5 hash of normalized query
  queryText       String      @map("query_text") @db.Text
  queryType       QueryType   @map("query_type")
  
  // Performance metrics
  executionTime   Int         @map("execution_time") // milliseconds
  rowsExamined    Int?        @map("rows_examined")
  rowsReturned    Int?        @map("rows_returned")
  
  // Query plan
  explainPlan     Json?       @map("explain_plan")
  
  // Context
  endpoint        String?     // Which API endpoint triggered this
  userId          String?     @map("user_id")
  
  // Frequency tracking
  executionCount  Int         @default(1) @map("execution_count")
  lastExecuted    DateTime    @default(now()) @map("last_executed")
  
  // Performance flags
  isSlowQuery     Boolean     @default(false) @map("is_slow_query")
  needsOptimization Boolean   @default(false) @map("needs_optimization")
  
  createdAt       DateTime    @default(now()) @map("created_at")

  user            User?       @relation(fields: [userId], references: [id])
  
  @@unique([queryHash])
  @@index([executionTime])
  @@index([isSlowQuery])
  @@index([lastExecuted])
  @@map("query_performance")
}

model SystemMetric {
  id              String      @id @default(uuid())
  
  metricName      String      @map("metric_name")
  metricValue     Float       @map("metric_value")
  unit            String?
  
  // Categorization
  category        MetricCategory
  source          String      // database, application, system
  
  // Context
  instanceId      String?     @map("instance_id") // For multi-instance deployments
  environment     String      @default("production")
  
  // Aggregation period
  period          MetricPeriod @default(REAL_TIME)
  periodStart     DateTime?   @map("period_start")
  periodEnd       DateTime?   @map("period_end")
  
  // Alerting
  threshold       Float?      // Alert threshold
  isAlert         Boolean     @default(false) @map("is_alert")
  
  timestamp       DateTime    @default(now())
  
  @@index([metricName, timestamp])
  @@index([category, timestamp])
  @@index([isAlert])
  @@map("system_metrics")
}

// ===== DATA QUALITY & VALIDATION =====

model DataQualityRule {
  id              String      @id @default(uuid())
  name            String
  description     String?
  
  // Target
  tableName       String      @map("table_name")
  columnName      String?     @map("column_name") // Null for table-level rules
  
  // Rule definition
  ruleType        QualityRuleType @map("rule_type")
  ruleExpression  String      @map("rule_expression") // SQL expression or regex
  
  // Thresholds
  warningThreshold Float?     @map("warning_threshold")
  errorThreshold  Float?      @map("error_threshold")
  
  // Execution
  frequency       CheckFrequency
  lastChecked     DateTime?   @map("last_checked")
  nextCheck       DateTime?   @map("next_check")
  
  // Results
  lastResult      QualityResult? @map("last_result")
  lastScore       Float?      @map("last_score")
  
  isEnabled       Boolean     @default(true) @map("is_enabled")
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  checks          DataQualityCheck[]
  
  @@index([tableName, columnName])
  @@index([nextCheck])
  @@map("data_quality_rules")
}

model DataQualityCheck {
  id              String      @id @default(uuid())
  ruleId          String      @map("rule_id")
  
  // Execution details
  executedAt      DateTime    @default(now()) @map("executed_at")
  executionTime   Int         @map("execution_time") // milliseconds
  
  // Results
  result          QualityResult
  score           Float       // Quality score (0-100)
  recordsChecked  Int         @map("records_checked")
  recordsFailed   Int         @map("records_failed")
  
  // Details
  errorDetails    Json?       @map("error_details")
  sampleFailures  Json?       @map("sample_failures")
  
  // Actions taken
  actionTaken     String?     @map("action_taken")
  alertSent       Boolean     @default(false) @map("alert_sent")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")

  rule            DataQualityRule @relation(fields: [ruleId], references: [id])
  
  @@index([ruleId, executedAt])
  @@index([result])
  @@map("data_quality_checks")
}

// ===== FEATURE FLAGS & EXPERIMENTATION =====

model FeatureFlag {
  id              String      @id @default(uuid())
  key             String      @unique
  name            String
  description     String?
  
  // Flag configuration
  flagType        FlagType    @map("flag_type")
  defaultValue    Json        @map("default_value") // Boolean, string, number, or JSON
  
  // Targeting rules
  targetingRules  Json        @map("targeting_rules")
  
  // Rollout configuration
  rolloutPercentage Float     @default(0) @map("rollout_percentage") // 0-100
  
  // Environments
  environments    String[]    @default(["production"])
  
  // Lifecycle
  status          FlagStatus  @default(ACTIVE)
  
  // Metadata
  owner           String?     // Team or person responsible
  tags            String[]    @default([])
  
  // Evaluation tracking
  evaluationCount Int         @default(0) @map("evaluation_count")
  lastEvaluated   DateTime?   @map("last_evaluated")
  
  // Lifecycle dates
  enabledAt       DateTime?   @map("enabled_at")
  disabledAt      DateTime?   @map("disabled_at")
  archivedAt      DateTime?   @map("archived_at")
  
  isActive        Boolean     @default(true) @map("is_active")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")

  evaluations     FlagEvaluation[]
  
  @@index([key])
  @@index([status])
  @@map("feature_flags")
}

model FlagEvaluation {
  id              String      @id @default(uuid())
  flagId          String      @map("flag_id")
  userId          String?     @map("user_id")
  
  // Context
  context         Json        // User attributes, request context, etc.
  
  // Result
  value           Json        // The evaluated value
  reason          String?     // Why this value was returned
  
  // Performance
  evaluationTime  Int         @map("evaluation_time") // microseconds
  
  timestamp       DateTime    @default(now())

  flag            FeatureFlag @relation(fields: [flagId], references: [id])
  user            User?       @relation(fields: [userId], references: [id])
  
  @@index([flagId, timestamp])
  @@index([userId])
  @@map("flag_evaluations")
}

