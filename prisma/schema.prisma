generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
  output   = "./generated/prisma"
  accelerateUrl = envenv("DATABASE_URL")
}

datasource db {
  provider = "postgresql"
  // url      = env("DATABASE_URL")
}

model Account {
  id           String         @id @default(uuid())
  accountType  AccountType    @map("account_type")
  status       Status         @default(ACTIVE)
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    BigInt         @default(0) @map("created_at")
  updatedAt    BigInt         @default(0) @map("updated_at")

  // Relations to separated concerns
  authentication AccountAuthentication?
  profile        AccountProfile?
  preferences    AccountPreferences?
  security       AccountSecurity?
  deviceSession  DeviceSession[]
  
  // Business logic relations
  userBehavior   UserBehavior?      // Only for USER accounts
  shopBusiness   ShopBusiness?      // Only for SHOP accounts
  adminAccess    AdminAccess?       // Only for ADMIN accounts

  // Comment-related relations
  comments         Comment[]
  // commentLikes     CommentLike[]
  // commentReports   CommentReport[]
  // resolvedReports  CommentReport[] @relation("ReportResolver")
  // moderationActions CommentModeration[]

  //notification relation
  notificationThread  NotificationThread?
  notification      Notification[]

  //coupon relation

  @@map("accounts")
}

// Separated Authentication Concern
model AccountAuthentication {
  accountId    String         @id
  username     String?        @unique
  email        String         @unique
  
  // Password-based auth
  passwordHash String?        @map("password_hash")
  passwordSalt String?        @map("password_salt")
  
  // Auth metadata
  authMethod   AuthMethod     @default(EMAIL_PASSWORD) @map("auth_method")
  isVerified   Boolean        @default(false) @map("is_verified")
  lastLoginAt  BigInt?        @map("last_login_at")
  loginCount   Int            @default(0) @map("login_count")
  
  isActive     Boolean        @default(true) @map("is_active")
  createdAt    BigInt         @default(0) @map("created_at")
  updatedAt    BigInt         @default(0) @map("updated_at")

  // Relations
  account      Account        @relation(fields: [accountId], references: [id])
  socialAuth   SocialAuthentication[]
  keyTokens    KeyToken[]
  passwordResets PasswordReset[]

  @@map("account_authentication")
}

// Social Authentication - Separate table
model SocialAuthentication {
  id           String      @id @default(uuid())
  authId       String      @map("auth_id")
  provider     String      // 'google', 'facebook', 'apple'
  providerId   String      @map("provider_id")
  providerEmail String?    @map("provider_email")
  accessToken  String?     @map("access_token")
  refreshToken String?     @map("refresh_token")
  expiresAt    BigInt?     @map("expires_at")
  
  isActive     Boolean     @default(true) @map("is_active")
  createdAt    BigInt      @default(0) @map("created_at")
  updatedAt    BigInt      @default(0) @map("updated_at")
  
  authentication AccountAuthentication @relation(fields: [authId], references: [accountId])

  @@unique([authId, provider])
  @@unique([provider, providerId])
  @@map("social_authentication")
}

// Security & Tokens - Separate concern
model AccountSecurity {
  accountId    String      @id
  roles        String[]    // JSON array
  permissions  String[]    // JSON array
  
  // Security settings
  twoFactorEnabled Boolean @default(false) @map("two_factor_enabled")
  twoFactorSecret  String? @map("two_factor_secret")
  backupCodes      String[] @map("backup_codes")
  
  // Security tracking
  failedLoginAttempts Int  @default(0) @map("failed_login_attempts")
  lockedUntil      BigInt? @map("locked_until")
  suspiciousActivity Boolean @default(false) @map("suspicious_activity")
  
  createdAt    BigInt      @default(0) @map("created_at")
  updatedAt    BigInt      @default(0) @map("updated_at")

  account      Account     @relation(fields: [accountId], references: [id])
  
  @@map("account_security")
}

model DeviceSession{
  id           String   @id @default(uuid())
  accountId String  //reference to account
  deviceId  String  @unique
  deviceName   String?
  lastLogin    DateTime @default(now())

  isActive  Boolean @default(true) @map("is_active")
  createdAt BigInt  @default(0) @map("created_at")
  updatedAt BigInt  @default(0) @map("updated_at")

  account Account @relation(fields: [accountId], references: [id])
}

// User-specific behavior and data
model UserBehavior {
  accountId    String      @id
  
  // Shopping behavior
  cart         Cart?
//   wishlist     Wishlist?//ASPITNF (at some point in the near future, this functionality would be implement)
  orders       Order[]
//   reviews      Review[]//ASPITNF (at some point in the near future, this functionality would be implement)
  
  // Engagement
  loyaltyPoints Int        @default(0) @map("loyalty_points")
  membershipTier String?   @map("membership_tier")@default("bronze")
  sex           Sex   @default(FEMALE)
  preferences   Json?      // Shopping preferences
  dateOfBirth   DateTime    @map("date_of_birth")
  
  createdAt    BigInt      @default(0) @map("created_at")
  updatedAt    BigInt      @default(0) @map("updated_at")

  account      Account     @relation(fields: [accountId], references: [id])
  
  @@map("user_behavior")
}

// Shop-specific business data
model ShopBusiness {
  accountId    String      @id
  
  // Business info
  businessName    String   @map("business_name")
  businessType    String   @map("business_type")
  taxId           String?  @map("tax_id")
  businessAddress String?  @map("business_address")
  
  // Shop operations
  spu        Spu[]
  orders          Order[]
  inventory       Inventory[]
  discount          Discount[]
//   analytics       ShopAnalytics?
  
  // Business metrics
  totalSales      Decimal  @default(0) @map("total_sales")
  totalOrders     Int      @default(0) @map("total_orders")
  rating          Float?   @default(0)
  
  createdAt    BigInt      @default(0) @map("created_at")
  updatedAt    BigInt      @default(0) @map("updated_at")

  account      Account     @relation(fields: [accountId], references: [id])
  
  @@map("shop_business")
}

// Admin-specific access and capabilities
model AdminAccess {
  accountId    String      @id
  
  // Admin info
  department   String
  position     String
  adminLevel   AdminLevel  @map("admin_level")
  supervisor   String?     // Another admin's accountId
  
  // Access control
  modules      String[]    // Which admin modules they can access
  territories  String[]    // Geographic or business areas they manage
  
  // Activity tracking
  lastActivity BigInt?     @map("last_activity")
  actionsToday Int         @default(0) @map("actions_today")
  
  createdAt    BigInt      @default(0) @map("created_at")
  updatedAt    BigInt      @default(0) @map("updated_at")

  account      Account     @relation(fields: [accountId], references: [id])
  adminLogs    AdminActivityLog[]
  
  @@map("admin_access")
}

// Generic profile for all account types
model AccountProfile {
  accountId    String      @id
  name         String
  avatar       String?
  phone        String?     @unique
  address      String?
  timezone     String?
  language     String?     @default("en")
  
  createdAt    BigInt      @default(0) @map("created_at")
  updatedAt    BigInt      @default(0) @map("updated_at")

  account      Account     @relation(fields: [accountId], references: [id])
  
  @@map("account_profiles")
}

// Account preferences and settings
model AccountPreferences {
  accountId    String      @id
  
  // Notification preferences
  emailNotifications    Boolean @default(true) @map("email_notifications")
  smsNotifications      Boolean @default(false) @map("sms_notifications")
  pushNotifications     Boolean @default(true) @map("push_notifications")
  
  // Privacy settings
  profileVisibility     String  @default("public") @map("profile_visibility")
  dataSharing           Boolean @default(false) @map("data_sharing")
  
  // UI preferences
  theme                 String  @default("light")
  language              String  @default("en")
  currency              String  @default("USD")
  
  createdAt    BigInt      @default(0) @map("created_at")
  updatedAt    BigInt      @default(0) @map("updated_at")

  account      Account     @relation(fields: [accountId], references: [id])
  
  @@map("account_preferences")
}

// Supporting models
model KeyToken {
  id               String      @id @default(uuid())
  authId           String      @map("auth_id")
  deviceId         String      @map("device_id")
  publicKey        String      @map("public_key")
  refreshToken     String      @map("refresh_token")
  expiresAt        BigInt?     @map("expires_at")
  
  isActive         Boolean     @default(true) @map("is_active")
  createdAt        BigInt      @default(0) @map("created_at")
  updatedAt        BigInt      @default(0) @map("updated_at")

  authentication   AccountAuthentication @relation(fields: [authId], references: [accountId])
  usedTokens       RefreshTokenUsed[]
  
  @@unique([authId, deviceId])
  @@map("key_tokens")
}

model RefreshTokenUsed {
  id         String   @id @default(uuid())
  keyTokenId String   @map("key_token_id")
  token      String   @map("refresh_token")
  usedAt     DateTime @default(now()) @map("used_at")
  reason     String?  // "logout", "refresh", "revoked", "expired", "suspicious_activity"
  userAgent  String?  @map("user_agent")
  ipAddress  String?  @map("ip_address")
  deviceInfo String?  @map("device_info")
  
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  BigInt   @default(0) @map("created_at")
  updatedAt  BigInt   @default(0) @map("updated_at")
  
  keyToken   KeyToken @relation(fields: [keyTokenId], references: [id])

  @@index([token])
  @@index([keyTokenId])
  @@map("refresh_tokens_used")
}

model PasswordReset {
  id           String      @id @default(uuid())
  authId       String      @map("auth_id")
  token        String      @unique
  tokenHash    String      @map("token_hash") // Hashed version for security
  
  // Request details
  requestedAt  DateTime    @default(now()) @map("requested_at")
  expiresAt    DateTime    @map("expires_at")
  ipAddress    String?     @map("ip_address")
  userAgent    String?     @map("user_agent")
  
  // Usage tracking
  isUsed       Boolean     @default(false) @map("is_used")
  usedAt       DateTime?   @map("used_at")
  usedIpAddress String?    @map("used_ip_address")
  usedUserAgent String?   @map("used_user_agent")
  
  // Security
  attemptCount Int         @default(0) @map("attempt_count")
  maxAttempts  Int         @default(5) @map("max_attempts")
  isBlocked    Boolean     @default(false) @map("is_blocked")
  
  createdAt    BigInt      @default(0) @map("created_at")
  updatedAt    BigInt      @default(0) @map("updated_at")
  
  authentication AccountAuthentication @relation(fields: [authId], references: [accountId])
  
  @@index([token])
  @@index([authId])
  @@index([expiresAt])
  @@map("password_resets")
}


model AdminActivityLog {
  id           String      @id @default(uuid())
  adminId      String      @map("admin_id")
  action       String      // "USER_BANNED", "PRODUCT_APPROVED", etc.
  targetType   String      @map("target_type") // "USER", "SHOP", "PRODUCT"
  targetId     String      @map("target_id")
  details      Json?
  ipAddress    String?     @map("ip_address")
  
  createdAt    BigInt      @default(0) @map("created_at")
  
  admin        AdminAccess @relation(fields: [adminId], references: [accountId])
  
  @@map("admin_activity_logs")
}

model Inventory {
    id                    String  @id @default(uuid())
    inventoryLocation     String  @default("unKnow") @map("inventory_location")
    inventoryStock        Int     @map("inventory_stock")

    isActive              Boolean @default(true) @map("is_active")
    createdAt             BigInt  @default(0) @map("created_at")
    updatedAt             BigInt  @default(0) @map("updated_at")

    //relation
    inventoryProductId    String  @unique @map("inventory_product_id")
    inventoryProduct      Sku @relation(fields: [inventoryProductId], references: [id])

    reservations          ReservationInventory[]
    orderItem             OrderItem[]

    shopBusiness    ShopBusiness    @relation(fields: [shopBusinessId], references: [accountId])
    shopBusinessId  String

    @@map("inventories")
}
model ReservationInventory {
  id             String     @id @default(uuid())
  inventory      Inventory  @relation(fields: [inventoryId], references: [id])
  inventoryId    String     @map("inventory_id")
  userId         String     @map("user_id")
  quantity       Int        @map("quantity") 
  expiredAt      DateTime   @map("expired_at")
  isConfirmed    Boolean    @default(false)
  valid          Boolean    @default(true)

  isActive       Boolean @default(true) @map("is_active")
  createdAt      BigInt  @default(0) @map("created_at")
  updatedAt      BigInt  @default(0) @map("updated_at")

  @@unique([inventoryId, userId])
  @@map("reservation_inventories")
}

model Discount {
  id                     String            @id @default(uuid())
  discountName           String            @map("discount_name")
  discountDescription    String            @map("discount_description")
  discountType           String            @default("fixed_amount") @map("discount_type")
  discountValue          Float             @map("discount_value")
  discountCode           String            @unique @map("discount_code")
  discountStartDates     DateTime          @map("discount_start_dates")
  discountEndDates       DateTime          @map("discount_end_dates")
  discountMaxUses        Int               @map("discount_max_uses")
  discountUsesCount      Int               @map("discount_uses_count")
  discountUsersUsed      String[]          @default([]) @map("discount_users_used")
  discountMaxUsesPerUser Int               @map("discount_max_uses_per_user")
  discountMinOrderValue  Float             @map("discount_min_order_value")
  discountShopId         String            @map("discount_shop")
  discountIsActive       Boolean           @default(true) @map("discount_is_active")
  discountAppliesTo      DiscountAppliesTo @map("discount_applies_to")
  discountProductIds     String[]          @default([]) @map("discount_product_ids")
  isActive               Boolean           @default(true) @map("is_active")
  createdAt              BigInt            @default(0) @map("created_at")
  updatedAt              BigInt            @default(0) @map("updated_at")
  discountShop           ShopBusiness      @relation(fields: [discountShopId], references: [accountId])

  @@map("discounts")
}

model Cart {
  id           String        @id @default(uuid())
  state        CartState     @default(ACTIVE) @map("cart_state")
  countProduct Int           @default(0) @map("cart_count_product")
  userId       String        @unique @map("cart_userId")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    BigInt        @default(0) @map("created_at")
  updatedAt    BigInt        @default(0) @map("updated_at")
  cartProducts CartProduct[]
  user         UserBehavior          @relation(fields: [userId], references: [accountId])

  @@map("carts")
}

model CartProduct {
  id        String  @id @default(uuid())
  productId String  @map("cart_product_productId")
  shopId    String  @map("cart_product_shopId")
  quantity  Int     @map("cart_product_quantity")
  name      String  @map("cart_product_name")
  price     Float   @map("cart_product_price")
  cartId    String  @map("cart_product_cartId")
  isActive  Boolean @default(true) @map("is_active")
  createdAt BigInt  @default(0) @map("created_at")
  updatedAt BigInt  @default(0) @map("updated_at")
  cart      Cart    @relation(fields: [cartId], references: [id])

  @@unique([cartId, productId])
  @@map("cart_products")
}

model Order {
  id              String      @id @default(uuid())
  userId          String      @map("user_id")
  status          OrderStatus @map("status")
  totalDiscount   Decimal     @map("total_discount ")
  shippingFee     Decimal     @map("shipping_fee")
  shippingAddress String      @map("shipping_street")
  totalPrice      Decimal     @map("total_price")
  paymentInfo     Json        @map("payment_info")
  paymentIntentId String?     @map("payment_intent_id")
  expiredAt       DateTime    @map("expired_at")

  isActive        Boolean     @default(true) @map("is_active")
  createdAt       BigInt      @default(0) @map("created_at")
  updatedAt       BigInt      @default(0) @map("updated_at")

  // Relations
  orderItems      OrderItem[]
  user            UserBehavior        @relation(fields: [userId], references: [accountId])

  shopBusiness      ShopBusiness    @relation(fields: [shopBusinessId],references: [accountId])
  shopBusinessId    String

  @@map("orders")
}

model OrderItem {
  id           String    @id @default(cuid())
  order        Order     @relation(fields: [orderId], references: [id])
  orderId      String
  inventoryId  String
  inventory    Inventory @relation(fields: [inventoryId], references: [id])
  
  quantity     Int
  price        Int

  isActive        Boolean     @default(true) @map("is_active")
  createdAt       BigInt      @default(0) @map("created_at")
  updatedAt       BigInt      @default(0) @map("updated_at")

  @@map("order_items")
}

model CommentClosureTable {
  ancestorId  String
  descendantId  String
  depth Int

  ancestor  Comment @relation("CommentAncestor", fields: [ancestorId], references: [id])
  descendants  Comment @relation("CommentDescendant", fields: [descendantId], references: [id])


  @@id([ancestorId, descendantId])
  @@map("comment_closure")
}

model Comment {
  id               String         @id @default(uuid())
  
  // Core content
  content          String         @map("content")
  contentType      CommentType    @default(TEXT) @map("content_type") // TEXT, HTML, MARKDOWN
  
  // What is being commented on (polymorphic)
  targetType       CommentTargetType @map("target_type") // PRODUCT, ORDER, REVIEW, etc.
  targetId         String         @map("target_id")
  
  // Author information
  authorId         String         @map("author_id")
  authorType       CommentAuthorType @default(USER) @map("author_type") // USER, SHOP, ADMIN
  
  // Thread grouping (optional - can be derived from closure table)
  threadId         String?        @map("thread_id") // Root comment ID for the thread

  // Status and moderation
  status           CommentStatus  @default(PUBLISHED) @map("status")
  isDeleted        Boolean        @default(false) @map("is_deleted")
  isPinned         Boolean        @default(false) @map("is_pinned")
  isEdited         Boolean        @default(false) @map("is_edited")
  editedAt         BigInt?        @map("edited_at")
  
  // Engagement
  likesCount       Int            @default(0) @map("likes_count")
  dislikesCount    Int            @default(0) @map("dislikes_count")
  repliesCount     Int            @default(0) @map("replies_count")
  
  // Metadata
  ipAddress        String?        @map("ip_address")@default("127.0.0.1")
  userAgent        String?        @map("user_agent")

  // Timestamps
  isActive         Boolean        @default(true) @map("is_active")
  createdAt        BigInt         @default(0) @map("created_at")
  updatedAt        BigInt         @default(0) @map("updated_at")

  // Relations
  ancestors    CommentClosureTable[] @relation("CommentDescendant")
  descendants  CommentClosureTable[] @relation("CommentAncestor")

  author           Account        @relation(fields: [authorId], references: [id])
  spuId            String         @map("spu_id")
  spu              Spu            @relation(fields: [spuId], references: [id])

  @@map("comments")
}

/*
  each user have a seperate thread like this (1-1 relation)
  and each thread have array of notification (1-n relation)
*/

model NotificationThread {
  id            String         @id @default(uuid())
  accountId        String         @unique @map("noti_thread_user_id")
  account          Account           @relation(fields: [accountId], references: [id])
  notifications Notification[]

  isActive  Boolean @default(true) @map("is_active")
  createdAt BigInt  @default(0) @map("created_at")
  updatedAt BigInt  @default(0) @map("updated_at")

  @@map("notification_threads")
}

model Notification {
  id       String             @id @default(uuid())
  type     NotificationType   @map("noti_type")
  sender   Account            @relation(fields: [senderId], references: [id])
  senderId String             @map("noti_sender_id")
  thread   NotificationThread @relation(fields: [threadId], references: [id])
  threadId String             @map("noti_thread_id")
  content  String             @map("noti_content")
  option   Json               @map("noti_option")
  status   String             @default("unread") @map("notification_status")

  productId  String? @map("noti_product_id")
  discountId String? @map("noti_discount_id")

  isActive  Boolean @default(true) @map("is_active")
  createdAt BigInt  @default(0) @map("created_at")
  updatedAt BigInt  @default(0) @map("updated_at")

  @@map("notifications")
}

/*

  standard product unit
  The SPU is the minimum unit of product information aggregation. 
  It is a set of reused, easy to retrieve standardized information, which describes a product.

*/

model Spu {
  id                 String   @id @default(uuid())
  name               String   @db.VarChar(100)@unique()
  intro              String?  @db.VarChar(200)
  brandId            String
  categoryId         String
  images             String[]  @db.VarChar(1000) //list of picture 
  afterSalesService  String?  @db.VarChar(50)
  content            String?  @db.Text  //introduce
  attributeList      String?  @db.VarChar(3000) //Specifications
  isMarketable       Boolean  @default(false) //Unsaleable or not
  status             Int      @default(0) //Review status, 0: Unaudited, 1: Reviewed, 2: Review does not pass
  shopBusinessId    String

  
  isActive  Boolean  @default(true) @map("is_active")
  createdAt BigInt   @default(0) @map("created_at")
  updatedAt BigInt   @default(0) @map("updated_at")

  /**
    this is for relation
    SPU and brand is n-1
    SPU and category is n-1
    SPU and SKU is 1-n
    SPU and Comment is 1-N
  */
  brand              Brand   @relation(fields: [brandId], references: [id])
  category           Category @relation(fields: [categoryId], references: [id])
  skus               Sku[]    @relation("SpuSkus")
  comment            Comment[]
  shopBusiness       ShopBusiness   @relation(fields: [shopBusinessId],references: [accountId])

  @@unique([name, brandId])
}

/*
  Sku = stock Keeping Unit (inventory unit)
  SKU is a physically indivisible minimum inventory unit.
  Treatment according to different industrial states and different management models during use. In clothing, shoes
*/
model Sku {
  id           String       @id @default(uuid())
  name         String       @db.VarChar(200)  //SKU name
  price        Int          @default(1)
  num          Int?         @default(100) // quantity
  image        String?      @db.VarChar(200)  ////Product Image
  images       String[]     @db.VarChar(2000) ////Product Image list

  spuId        String       @db.VarChar(60)
  brandName    String?      @db.VarChar(100)
  skuAttribute String?      @db.VarChar(200) ////Specification
  status       Int?         @default(1)
  inventoryId  String?    @map("inventory_id")

  isActive  Boolean  @default(true) @map("is_active")
  createdAt BigInt   @default(0) @map("created_at")
  updatedAt BigInt   @default(0) @map("updated_at")

  // relations
  spu          Spu?      @relation("SpuSkus", fields: [spuId], references: [id])
  inventory   Inventory?

  @@index([status])
  @@index([updatedAt], name: "updated")
}
/*
  IMPRORTANT: The creatationn of category must be handled by admin and must not be done by seller and user
  
  this is self relation table
  Electricity (parentId = null)
  └── Phone (parentId = Electricity)
      └── Smartphone (parentId = Phone)
*/

model Category {
  id         String      @id @default(uuid())
  name      String?   @db.VarChar(50)
  sort      Int?

  isActive  Boolean  @default(true) @map("is_active")
  createdAt BigInt   @default(0) @map("created_at")
  updatedAt BigInt   @default(0) @map("updated_at")

  ancestors CategoryClosureTable[]  @relation("ancestor")
  descendants CategoryClosureTable[]  @relation("descendant")

  spu  Spu[]
  brands    CategoryBrand[]
  attrs     CategoryAttr[]
}

model CategoryClosureTable {

  ancestorId String
  descendantId String
  depth Int
  ancestor   Category @relation("ancestor", fields: [ancestorId], references: [id])
  descendant Category @relation("descendant",fields: [descendantId], references: [id])

  isActive  Boolean  @default(true) @map("is_active")
  createdAt BigInt   @default(0) @map("created_at")
  updatedAt BigInt   @default(0) @map("updated_at")
  
  @@id([ancestorId, descendantId])
}

model Brand {
  id              String      @id @default(uuid())
  name     String  @db.VarChar(100)@unique()
  image    String  @default("") @db.VarChar(1000)
  initial  String  @default("") @db.VarChar(1)
  sort     Int?    @default(10)

  isActive  Boolean  @default(true) @map("is_active")
  createdAt BigInt   @default(0) @map("created_at")
  updatedAt BigInt   @default(0) @map("updated_at")

  // relations
  spu     Spu[]

  categories CategoryBrand[]
}
  
model CategoryBrand {
  categoryId String
  brandId    String

  // relations
  category   Category @relation(fields: [categoryId], references: [id])
  brand      Brand    @relation(fields: [brandId], references: [id])

  @@id([brandId, categoryId])
}

model CategoryAttr {
  categoryId String
  attrId     String

  // relations
  category   Category @relation(fields: [categoryId], references: [id])
  attribute  SkuAttribute @relation(fields: [attrId], references: [id])

  @@id([categoryId, attrId])
}

model SkuAttribute {
  id         String      @id @default(uuid())
  name    String? @db.VarChar(50)
  options String? @db.VarChar(2000)
  sort    Int?

  categories CategoryAttr[]
}

