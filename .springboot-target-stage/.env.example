# Synthetic placeholders only. Prefer Spring environment variables or a secret manager.
SPRING_PROFILES_ACTIVE=local
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecommerce
SPRING_DATASOURCE_USERNAME=replace-me-local
SPRING_DATASOURCE_PASSWORD=replace-me-local
ECOMMERCE_SECURITY_ISSUER=local-ecommerce
ECOMMERCE_SECURITY_AUDIENCE=ecommerce-api
ECOMMERCE_TOKEN_DIGEST_PEPPER=local-token-digest-pepper-change-me
ECOMMERCE_CORS_ALLOWED_ORIGINS=http://localhost:3000
ECOMMERCE_PASSWORD_RESET_FROM=no-reply@example.test
ECOMMERCE_PASSWORD_RESET_URL=http://localhost:3000/reset-password
SPRING_MAIL_HOST=localhost
SPRING_MAIL_PORT=1025
# SMTP is optional locally. Enable its aggregate health contribution only when
# an SMTP service is intentionally configured and monitored.
MAIL_HEALTH_ENABLED=false
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3057/v1/api/auth/auth/google/callback
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=usd
# Kafka and scheduled order expiry are opt-in. Kafka events use the database
# outbox and notification consumers keep a durable idempotency receipt.
KAFKA_ENABLED=false
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_NOTIFICATION_GROUP_ID=ecommerce-spring-notifications-v1
KAFKA_OUTBOX_BATCH_SIZE=50
KAFKA_OUTBOX_CLAIM_TIMEOUT=PT5M
ORDER_EXPIRATION_JOB_ENABLED=false
ORDER_EXPIRATION_JOB_BATCH_SIZE=50
ORDER_EXPIRATION_JOB_FIXED_DELAY=PT15M
